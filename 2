                if flat.Magnitude < 0.01 then return end
                myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + flat.Unit)
            end)
        end
    end

    if (COMBO.ManualMouseButton == nil and input.KeyCode == COMBO.ManualKey)
        or (COMBO.ManualMouseButton ~= nil and input.UserInputType == COMBO.ManualMouseButton) then
        if not comboInProgress and State.Locked and State.Target and isInRange(State.Target, COMBO.Range) then
