local function getClosestLockedTarget()
    if not State.AntiTeamingEnabled or not State.softLockEnabled then
        return State.Target
    end
    local closest, closestDist = nil, math.huge
    for _, p in ipairs(State.MultiTargets) do
        local d = getDistance(p)
        if d < closestDist then
            closestDist = d
            closest = p
        end
    end
    return closest
end

local function isLockedTarget(player)
