    if not Settings.FlightEnabled then isFlying = false end
    if isFlying and character and not character:FindFirstChild("HumanoidRootPart") then isFlying = false end

    if isFlying ~= wasFlying then
        if isFlying then
            rootPart.Anchored       = false
