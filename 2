-- Drag handle: titleBar drags the whole container (non-minimized)
local dragDetector = Instance.new("UIDragDetector")
dragDetector.DragStyle = Enum.UIDragDetectorDragStyle.TranslateXY
dragDetector.ResponseStyle = Enum.UIDragDetectorResponseStyle.CustomFunction
dragDetector.CustomFunction = function(detector, inputPosition, delta)
    container.Position = UDim2.new(
        container.Position.X.Scale,
        container.Position.X.Offset + delta.X,
        container.Position.Y.Scale,
        container.Position.Y.Offset + delta.Y
    )
    return delta
end
