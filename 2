local function holdF(attackerPlayer, holdTime)
    if not State.autoBlockEnabled then return end

    local function executeBlock()
        if State.isHolding then return end
        State.isHolding = true

        local shouldPunish =
            State.autoPunishEnabled
            and not State.punishCooldown
            and tick() > State.spinLockUntil
            and attackerPlayer
            and isInRange(attackerPlayer, BLOCK.DELAYED_RANGE)

        engageTempCharLock()
        startBlockHold(holdTime)

        task.delay(holdTime, function()
            if shouldPunish then
                State.punishCooldown = true
                task.wait(0.05)
                tapM1()
                task.delay(0.2, function()
                    releaseTempCharLock()
                end)
                task.delay(1, function()
                    State.punishCooldown = false
                end)
            end
        end)

        local snapTime = shouldPunish and (holdTime + BLOCK.PUNISH_EXTRA_TIME) or holdTime
        task.delay(snapTime, function()
            State.isHolding = false
            if not shouldPunish then
                releaseTempCharLock()
            end
        end)
    end

    executeBlock()
end

