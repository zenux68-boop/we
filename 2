local function checkAttack(args, remote)
    if not State.Locked or not State.Target then return end

    local serviceName = remote.Parent.Parent.Name

    local attackerPlayer = nil
    if typeof(args[2]) == "Instance" then
        attackerPlayer = Players:GetPlayerFromCharacter(args[2])
        if not attackerPlayer and args[2]:IsA("Player") then
            attackerPlayer = args[2]
        end
    end
    if not attackerPlayer then
        for _, v in ipairs(args) do
            if typeof(v) == "Instance" then
                if v:IsA("Player") then
                    attackerPlayer = v; break
                end
                local fromChar = Players:GetPlayerFromCharacter(v)
                if fromChar then attackerPlayer = fromChar; break end
            end
        end
    end

    if State.AntiTeamingEnabled and State.softLockEnabled and attackerPlayer and isLockedTarget(attackerPlayer) then
        local attackerDist  = getDistance(attackerPlayer)
        local closestTarget = getClosestLockedTarget()
        local closestDist   = closestTarget and getDistance(closestTarget) or math.huge
        if attackerDist <= closestDist then
            State.Target = attackerPlayer
        end
    end

    if not attackerPlayer or not isLockedTarget(attackerPlayer) then return end
    if attackerPlayer == LocalPlayer then return end

