            playLaunchEffect()
        else
            stopSuppressingAnimations()
            humanoid.CameraOffset  = Vector3.new(0, 0, 0)
            humanoid.PlatformStand = false
            if savedAutoRotate ~= nil then
                humanoid.AutoRotate = savedAutoRotate
                savedAutoRotate = nil
            end
            snapPoseToNeutral()
            bodyVelocity.MaxForce = Vector3.new(0, 0, 0)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyGyro.MaxTorque    = Vector3.new(0, 0, 0)
            currentVelocity = Vector3.new()
        end
        wasFlying = isFlying
    end

    if not isFlying then return end

    forceFlightStateThisFrame()
    if not bodyVelocity or not bodyGyro then return end

    local camCFrame  = Camera.CFrame
    local lookVector = camCFrame.LookVector
    local flatRight  = Vector3.new(camCFrame.RightVector.X, 0, camCFrame.RightVector.Z)
    if flatRight.Magnitude > 0.001 then flatRight = flatRight.Unit else flatRight = Vector3.new(1, 0, 0) end

    local moveDir = Vector3.new()
    if heldKeys.W then moveDir += lookVector end
    if heldKeys.S then moveDir -= lookVector end
    if heldKeys.D then moveDir += flatRight  end
    if heldKeys.A then moveDir -= flatRight  end

    local hasHorizontalInput = moveDir.Magnitude > 0.001
    if hasHorizontalInput then moveDir = moveDir.Unit end

    local verticalDir = 0
    if heldKeys.Up   then verticalDir += 1 end
    if heldKeys.Down then verticalDir -= 1 end

    local hasAnyInput = hasHorizontalInput or verticalDir ~= 0
    local speed = Settings.BaseSpeed
    if heldKeys.Sprint and hasAnyInput then speed = speed * Settings.SprintMultiplier end

    local targetVelocity = (moveDir * speed) + Vector3.new(0, verticalDir * Settings.VerticalSpeed, 0)
    local alpha = math.clamp(Settings.Acceleration * dt, 0, 1)
    currentVelocity       = currentVelocity:Lerp(targetVelocity, alpha)
    bodyVelocity.Velocity = currentVelocity

    local maxSpeed  = Settings.BaseSpeed * Settings.SprintMultiplier
    local speedRatio = math.clamp(currentVelocity.Magnitude / maxSpeed, 0, 1)
    local diveRatio  = math.clamp(speedRatio / 0.5, 0, 1)
    local pitchAngle = diveRatio * math.rad(Settings.MaxDiveDegrees)

    local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
    if flatLook.Magnitude < 0.001 then
        flatLook = Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
    end
    flatLook = flatLook.Unit

    local lateralAmount = flatRight:Dot(moveDir)
    local bankAngle     = math.rad(Settings.MaxTiltDegrees) * lateralAmount

    local newForward = (flatLook * math.cos(pitchAngle)) + (Vector3.new(0, -1, 0) * math.sin(pitchAngle))
    newForward = newForward.Unit
    local newUp = (Vector3.new(0, 1, 0) * math.cos(pitchAngle)) + (flatLook * math.sin(pitchAngle))
    newUp = newUp.Unit
    local rightAxis = newForward:Cross(newUp).Unit

    if bankAngle ~= 0 then
        local cosB, sinB = math.cos(bankAngle), math.sin(bankAngle)
        local rolledUp    = (newUp * cosB)    + (rightAxis * sinB)
        local rolledRight = (rightAxis * cosB) - (newUp * sinB)
        newUp     = rolledUp.Unit
        rightAxis = rolledRight.Unit
    end

    bodyGyro.CFrame = CFrame.fromMatrix(rootPart.Position, rightAxis, newUp, -newForward)
    applyFlyingPose(dt, speedRatio, hasAnyInput)
end)

