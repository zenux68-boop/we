local function isInRange(player, range)
    local myRoot = getMyRootPart()
    if not myRoot or not player.Character then return false end
    local theirRoot = player.Character:FindFirstChild("HumanoidRootPart")
    if not theirRoot then return false end
    return (myRoot.Position - theirRoot.Position).Magnitude <= range
end

