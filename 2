local function isKnitEffectsRemote(obj)
    if not obj:IsA("RemoteEvent") then return false end
    if obj.Name ~= "Effects" then return false end
    local re       = obj.Parent
    if not re or re.Name ~= "RE" then return false end
    local svc      = re.Parent
    if not svc then return false end
    local services = svc.Parent
    if not services or services.Name ~= "Services" then return false end
    local knit     = services.Parent
    return knit ~= nil and knit.Name == "Knit"
end

local function getServiceName(remote)
    return remote.Parent.Parent.Name
end

local debugLines = {}
local debugLabel = nil

local function debugLog(msg)
    table.insert(debugLines, 1, msg)
    if #debugLines > 8 then table.remove(debugLines, #debugLines) end
    if debugLabel then
        debugLabel.Text = table.concat(debugLines, "\n")
    end
end

local hookedRemotes = {}

local function hookRemote(remote)
    if hookedRemotes[remote] then return end
    hookedRemotes[remote] = true

    local serviceName = getServiceName(remote)

    remote.OnClientEvent:Connect(function(...)
        local args    = { ... }
        local svcName = serviceName

        if args[1] == "Chase" then
            local attackerChar   = args[2]
