--========================================================================
-- LOCK / UNLOCK
--========================================================================
local LockOnUpdateConn = nil
local CameraUpdateConn = nil
local TargetWatchConns = {}

local function clearTargetWatchers()
    for _, c in ipairs(TargetWatchConns) do c:Disconnect() end
    TargetWatchConns = {}
end

local UnlockFn, LockFn

local function watchTarget(player)
    clearTargetWatchers()
    if CONFIG.BreakLockOnTargetLeave then
        table.insert(TargetWatchConns, Players.PlayerRemoving:Connect(function(p)
            if p == player then UnlockFn() end
        end))
    end
    if CONFIG.BreakLockOnTargetDeath then
        local hum = getHumanoid(player)
        if hum then
            table.insert(TargetWatchConns, hum.Died:Connect(UnlockFn))
        end
        table.insert(TargetWatchConns, player.CharacterAdded:Connect(function(nc)
            local nh = nc:WaitForChild("Humanoid", 5)
            if nh and State.Target == player then
                table.insert(TargetWatchConns, nh.Died:Connect(UnlockFn))
            end
        end))
        table.insert(TargetWatchConns, player.CharacterRemoving:Connect(function()
            if State.Target == player then UnlockFn() end
        end))
    end
end

local function onHeartbeat()
    if not State.Locked or not State.Target then return end
    if State.AntiTeamingEnabled and State.softLockEnabled then
        State.MultiTargets = (function()
            local valid = {}
            for _, p in ipairs(State.MultiTargets) do
                if isValidCandidate(p) then table.insert(valid, p) end
            end
            return valid
        end)()
        if #State.MultiTargets == 0 then UnlockFn(); return end
        State.Target = getClosestLockedTarget()
    else
        if not isValidCandidate(State.Target) then UnlockFn(); return end
    end
    if State.comboDashLock then return end
    if State.AnglePredActive and not State.softLockEnabled then return end
    if State.softLockEnabled and not State.tempCharLock and not State.comboDashLock then return end

    local tp   = getTargetPosition(State.Target)
    local root = getMyRootPart()
    if not tp or not root then UnlockFn(); return end

    if (tp - root.Position).Magnitude <= 1.0 then return end

    if anglePredLockActive then return end

    local flat = Vector3.new(tp.X - root.Position.X, 0, tp.Z - root.Position.Z)
    if flat.Magnitude < 0.01 then
        local lv = root.CFrame.LookVector
        flat = Vector3.new(lv.X, 0, lv.Z)
    end
    root.CFrame = CFrame.new(root.Position, root.Position + flat.Unit)
end

local function onRenderStepped()
    if not State.Locked or not State.Target then return end
    if State.softLockEnabled and not State.AntiTeamingEnabled then
        if State.AnglePredActive and tick() > State.AnglePredEndTime then
            deactivateAnglePrediction()
        end
        return
    end
    if State.AntiTeamingEnabled and State.softLockEnabled then
        State.Target = getClosestLockedTarget()
        if not State.Target then return end
    end
    if Camera.CameraType ~= Enum.CameraType.Scriptable then return end

    if State.AnglePredActive and tick() > State.AnglePredEndTime then
        deactivateAnglePrediction()
    end

    local tp   = getTargetPosition(State.Target)
    local root = getMyRootPart()
    if not tp or not root then return end

    if (tp - root.Position).Magnitude <= 1.0 then return end

    local up    = Vector3.new(0, 1, 0)
    local flat  = Vector3.new(tp.X - root.Position.X, 0, tp.Z - root.Position.Z)
    if flat.Magnitude < 0.01 then
        local lv = root.CFrame.LookVector
        flat = Vector3.new(lv.X, 0, lv.Z)
    end
    flat = flat.Unit
    local right = flat:Cross(up)
    if right.Magnitude > 0.01 then right = right.Unit end

    local aimPt      = tp + up * CONFIG.CameraVerticalOffset + right * CONFIG.CameraAimSideOffset
    local basePos    = root.Position - flat * CONFIG.CameraBackDistance + up * CONFIG.CameraHeight
    local desiredPos = basePos + right * CONFIG.CameraSideOffset + up * CONFIG.CameraUpOffset

    local ray      = desiredPos - basePos
    local finalPos = desiredPos
    if ray.Magnitude > 0.01 then
        local hit = Workspace:Raycast(basePos, ray, cameraRayParams)
        if hit then
            local d = math.max((hit.Position - basePos).Magnitude - CONFIG.CameraCollisionPadding, 0.5)
            finalPos = basePos + ray.Unit * d
        end
    end

    if CONFIG.BreakLockOnOutOfRange then
        if (tp - finalPos).Magnitude > CONFIG.MaxLockDistance + CONFIG.OutOfRangeBuffer then
            UnlockFn(); return
        end
    end

    if (aimPt - finalPos).Magnitude > 0.01 then
        Camera.CFrame = CFrame.new(finalPos, aimPt)
    end
end

UnlockFn = function()
    if not State.Locked then return end
    if blockHoldActive then
        blockHoldActive = false
        scriptHoldingF = false
        if blockHoldConn then blockHoldConn:Disconnect(); blockHoldConn = nil end
        game:GetService("ReplicatedStorage").Knit.Knit.Services.BlockService.RE.Deactivated:FireServer()
        scriptHeldKeys[BLOCK.BLOCK_KEY] = nil
        rawBlockActive = false
    end
    State.Locked            = false
    State.Target            = nil
    State.MultiTargets      = {}
    State.AnglePredActive   = false
    State.AnglePredOrbitDeg = 0
    State.AnglePredEndTime  = 0
    State.AnglePredDashDir  = nil
    State.isHolding         = false
    State.comboDashLock     = false
    comboInProgress         = false
    comboManualArmed        = false
    comboInProgress2        = false
    comboManualArmed2       = false
    lockingAtBack           = false
    comboArmedPersistent    = false
    if GUI_API.SetCombo3Armed then GUI_API.SetCombo3Armed(false) end

    if LockOnUpdateConn then LockOnUpdateConn:Disconnect(); LockOnUpdateConn = nil end
    if CameraUpdateConn then CameraUpdateConn:Disconnect(); CameraUpdateConn = nil end
    if FacingAlignOrientation then FacingAlignOrientation.Enabled = false end
    clearTargetWatchers()
    destroyReticle()
    if not State.softLockEnabled then
        Camera.CameraType = Enum.CameraType.Custom
