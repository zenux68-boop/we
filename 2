    do
        local toMe = Vector3.new(myRoot.Position.X - theirRoot.Position.X, 0, myRoot.Position.Z - theirRoot.Position.Z)
        if toMe.Magnitude > 0.01 then
            local theirFwd = Vector3.new(theirRoot.CFrame.LookVector.X, 0, theirRoot.CFrame.LookVector.Z).Unit
            if theirFwd:Dot(toMe.Unit) < BACK_DOT then alreadyAtBack = true end
        end
