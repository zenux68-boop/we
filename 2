    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    return hrp:FindFirstChild("RootJoint")
end

local function stopAllInvisAnimTracks()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.Animation and track.Animation.AnimationId == INVIS.ANIM_ID then
            track:Stop(0)
        end
    end
end

local function cleanupInvis()
    invisActive = false
    invisLoopGen = invisLoopGen + 1

    if invisPreSimConn then invisPreSimConn:Disconnect(); invisPreSimConn = nil end
    if invisRagdollConn then invisRagdollConn:Disconnect(); invisRagdollConn = nil end
    if invisTranspConn then invisTranspConn:Disconnect(); invisTranspConn = nil end

    if invisAnimTrack then
        pcall(function() invisAnimTrack:Stop(0) end)
        invisAnimTrack = nil
    end

    stopAllInvisAnimTracks()

    local char = LocalPlayer.Character
    if char then
        for _, animObj in ipairs(char:GetChildren()) do
            if animObj:IsA("Animation") then animObj:Destroy() end
        end
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("Motor6D") then
                pcall(function() v.Enabled = true end)
            elseif v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
                pcall(function() v.Enabled = false end)
            end
        end
    end

    -- restore full visibility
    local char2 = LocalPlayer.Character
    if not char2 then return end
    for _, part in ipairs(char2:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.LocalTransparencyModifier = 0
        end
    end
end

local function startInvis()
    local char = LocalPlayer.Character
    if not char then return end
    local animator = getInvisAnimator()
    if not animator then return end

    cleanupInvis()
    invisActive = true
    local myGen = invisLoopGen

    -- enforce 0.5 transparency every PostSimulation frame
    invisTranspConn = RunService.PostSimulation:Connect(function()
        if not invisActive then return end
        local char2 = LocalPlayer.Character
        if not char2 then return end
        for _, part in ipairs(char2:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                if part.LocalTransparencyModifier ~= INVIS.TRANSPARENCY then
                    part.LocalTransparencyModifier = INVIS.TRANSPARENCY
                end
            end
        end
    end)

    local anim = Instance.new("Animation")
    anim.AnimationId = INVIS.ANIM_ID
    anim.Parent = char
    invisAnimObj = anim

    local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)
    if not ok then
        warn("[INVIS] LoadAnimation failed:", track)
        invisActive = false
        return
    end

    invisAnimTrack = track
    invisAnimTrack.Priority = Enum.AnimationPriority.Action4
    invisAnimTrack:Play(0, 1, 1)
    invisAnimTrack:AdjustSpeed(0)
    RunService.Heartbeat:Wait()
    invisAnimTrack.TimePosition = INVIS.SEEK_TIME
    RunService.Heartbeat:Wait()
    RunService.Heartbeat:Wait()
    invisAnimTrack:AdjustSpeed(0)

    invisPreSimConn = RunService.PreSimulation:Connect(function()
        if not invisActive then return end
        local rootJoint = getInvisRootJoint()
        if rootJoint then
            rootJoint.Transform = CFrame.new()
        end
    end)

    invisRagdollConn = RunService.PreSimulation:Connect(function()
        if not invisActive then return end
        local char2 = LocalPlayer.Character
        if not char2 then return end
        for _, v in ipairs(char2:GetDescendants()) do
            if v:IsA("Motor6D") then
                pcall(function() v.Enabled = true end)
            elseif v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
                pcall(function() v.Enabled = false end)
            end
        end
    end)

    task.spawn(function()
        while invisActive and invisLoopGen == myGen do
            local animator2 = getInvisAnimator()
            if animator2 and invisAnimObj and invisLoopGen == myGen then
                local ok2, track2 = pcall(function()
                    return animator2:LoadAnimation(invisAnimObj)
                end)
                if ok2 and track2 and invisLoopGen == myGen then
                    if invisAnimTrack then invisAnimTrack:Stop(0) end
                    invisAnimTrack = track2
                    invisAnimTrack.Priority = Enum.AnimationPriority.Action4
                    invisAnimTrack:Play(0, 1, 1)
                    invisAnimTrack:AdjustSpeed(0)
                    invisAnimTrack.TimePosition = INVIS.SEEK_TIME
                end
            end
            task.wait()
        end
        stopAllInvisAnimTracks()
    end)
end

local function stopInvis()
    cleanupInvis()
end

local function toggleInvis()
    INVIS.Enabled = not INVIS.Enabled
    if INVIS.Enabled then
        startInvis()
    else
        stopInvis()
    end
end

