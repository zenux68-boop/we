                and Players:GetPlayerFromCharacter(attackerChar) or nil

            if attackerPlayer and attackerPlayer == State.Target then
                local myRoot    = getMyRootPart()
                local targetPos = getTargetPosition(State.Target)
                if myRoot and targetPos then
                    local dist = (Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z) - myRoot.Position).Magnitude
                    if dist <= ANGLEPRED.ForwardActivationRange then
                        local flatFace = Vector3.new(
                            targetPos.X - myRoot.Position.X, 0,
                            targetPos.Z - myRoot.Position.Z)
                        if flatFace.Magnitude < 0.01 then
                            local lv = myRoot.CFrame.LookVector
                            flatFace = Vector3.new(lv.X, 0, lv.Z)
                        end
                        flatFace = flatFace.Unit

                        local rad  = math.rad(ANGLEPRED.ForwardAngle)
                        local cosR = math.cos(rad)
                        local sinR = math.sin(rad)
                        local newFaceDir = Vector3.new(
                            flatFace.X * cosR - flatFace.Z * sinR,
                            0,
                            flatFace.X * sinR + flatFace.Z * cosR
                        ).Unit

                        if FacingAlignOrientation then FacingAlignOrientation.Enabled = false end

                        if State.softLockEnabled then
                            anglePredLockActive = true
                        end

                        myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + newFaceDir)

                        State.AnglePredActive   = true
                        State.AnglePredEndTime  = tick() + ANGLEPRED.ForwardReturnTimer
                        State.AnglePredOrbitDeg = ANGLEPRED.ForwardAngle
                        State.AnglePredDashDir  = "Forward"
                        setReticleColor(Color3.fromRGB(255, 200, 0))

                        if State.softLockEnabled then
                            task.delay(ANGLEPRED.ForwardReturnTimer + 0.05, function()
                                anglePredLockActive = false
                            end)
                        end

                        rawBlock(BLOCK.SPECIAL_HOLD_TIME, nil)
