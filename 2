    local myRoot    = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local theirRoot = player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not theirRoot then return false end

    local toMe = Vector3.new(
        myRoot.Position.X - theirRoot.Position.X,
        0,
        myRoot.Position.Z - theirRoot.Position.Z)
    if toMe.Magnitude < 0.01 then return false end
    toMe = toMe.Unit

    local theirFwd = Vector3.new(
        theirRoot.CFrame.LookVector.X, 0,
        theirRoot.CFrame.LookVector.Z)
    if theirFwd.Magnitude < 0.01 then return false end
    theirFwd = theirFwd.Unit

    return theirFwd:Dot(toMe) < BACK_DOT
end

