miniLabel.TextSize           = 11
miniLabel.TextXAlignment     = Enum.TextXAlignment.Center
miniLabel.TextYAlignment     = Enum.TextYAlignment.Center
miniLabel.ZIndex             = 12
miniLabel.Visible            = false
miniLabel.Parent             = container

-- Minimized drag: UIDragDetector on container itself when minimized
local miniDragDetector = Instance.new("UIDragDetector")
miniDragDetector.DragStyle = Enum.UIDragDetectorDragStyle.TranslateXY
miniDragDetector.ResponseStyle = Enum.UIDragDetectorResponseStyle.CustomFunction
miniDragDetector.CustomFunction = function(detector, inputPosition, delta)
    container.Position = UDim2.new(
        container.Position.X.Scale,
        container.Position.X.Offset + delta.X,
        container.Position.Y.Scale,
        container.Position.Y.Offset + delta.Y
    )
    return delta
end
miniDragDetector.Enabled = false
miniDragDetector.Parent = container

local miniDragStartTime = 0

local function setMinimized(val)
    minimized = val
    if minimized then
        body.Visible               = false
        titleBar.Visible           = false
        container.Size             = UDim2.new(0, 50, 0, 50)
        container.BackgroundColor3 = ACCENT
        miniLabel.Visible          = true
        miniDragDetector.Enabled   = true
        dragDetector.Enabled       = false
        local tName = State.Target and State.Target.Name or "HUB"
        miniLabel.Text = tName
    else
        body.Visible               = true
        titleBar.Visible           = true
        container.Size             = UDim2.new(0, TOTAL_W, 0, TOTAL_H)
        container.BackgroundColor3 = BG_MAIN
        miniLabel.Visible          = false
        miniDragDetector.Enabled   = false
        dragDetector.Enabled       = true
    end
end

miniDragDetector.DragStart:Connect(function()
    miniDragStartTime = tick()
end)
miniDragDetector.DragEnd:Connect(function()
    if tick() - miniDragStartTime < 0.2 then
        setMinimized(false)
    end
end)

minimizeBtn.Activated:Connect(function()
    setMinimized(true)
end)

local dragStartPos = nil
local dragStartContainerPos = nil
local dragMoved = false

UserInputService.InputBegan:Connect(function(input, processed)
    if not minimized then return end
    if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    local pos = input.Position
    local abs = container.AbsolutePosition
    local sz  = container.AbsoluteSize
    if pos.X >= abs.X and pos.X <= abs.X + sz.X
    and pos.Y >= abs.Y and pos.Y <= abs.Y + sz.Y then
        dragStartPos = Vector2.new(pos.X, pos.Y)
        dragStartContainerPos = container.Position
        dragMoved = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not minimized then return end
    if not dragStartPos then return end
    if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    local pos = input.Position
    local delta = Vector2.new(pos.X - dragStartPos.X, pos.Y - dragStartPos.Y)
    if delta.Magnitude > 6 then
        dragMoved = true
        container.Position = UDim2.new(
            dragStartContainerPos.X.Scale,
            dragStartContainerPos.X.Offset + delta.X,
            dragStartContainerPos.Y.Scale,
            dragStartContainerPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not minimized then return end
    if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if dragStartPos and not dragMoved then
        local pos = input.Position
        local abs = container.AbsolutePosition
        local sz  = container.AbsoluteSize
        if pos.X >= abs.X and pos.X <= abs.X + sz.X
        and pos.Y >= abs.Y and pos.Y <= abs.Y + sz.Y then
            setMinimized(false)
        end
    end
    dragStartPos = nil
    dragStartContainerPos = nil
    dragMoved = false
end)
end

