LockFn = function()
    if State.Locked then return end
    local target = findBestTarget()
    if not target then return end
    State.Locked = true
    State.Target = target

    watchTarget(target)
    createReticleFor(target)

    if LockOnUpdateConn then LockOnUpdateConn:Disconnect() end
    LockOnUpdateConn = RunService.Heartbeat:Connect(onHeartbeat)
    if CameraUpdateConn then CameraUpdateConn:Disconnect() end
    CameraUpdateConn = RunService.RenderStepped:Connect(onRenderStepped)

    if not State.softLockEnabled then
        local c = LocalPlayer.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h.AutoRotate = false end
        end
        Camera.CameraType = Enum.CameraType.Scriptable
    end

    if GUI_API.SetStatus then GUI_API.SetStatus(true, target.Name) end
end

local function ToggleLockOn()
    if State.AntiTeamingEnabled and State.softLockEnabled then
        local target = findBestTarget()
        if not target then return end
        for i, p in ipairs(State.MultiTargets) do
            if p == target then
                if p.Character then
                    local root = p.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local reticle = root:FindFirstChild("LockOnReticle")
                        if reticle then reticle:Destroy() end
                    end
                end
                table.remove(State.MultiTargets, i)
                if #State.MultiTargets == 0 then
                    State.Locked = false
                    State.Target = nil
                else
                    State.Target = getClosestLockedTarget()
                end
                return
            end
        end
        table.insert(State.MultiTargets, target)
        State.Locked = true
        State.Target = getClosestLockedTarget()
        createReticleFor(target)
        watchTarget(target)
        if not LockOnUpdateConn then
            LockOnUpdateConn = RunService.Heartbeat:Connect(onHeartbeat)
        end
        if not CameraUpdateConn then
            CameraUpdateConn = RunService.RenderStepped:Connect(onRenderStepped)
        end
        Camera.CameraType = Enum.CameraType.Scriptable
        if GUI_API.SetStatus then GUI_API.SetStatus(true, State.Target and State.Target.Name) end
        return
    end
    if State.Locked then UnlockFn() else LockFn() end
end

