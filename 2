local function chainSideDash(target)
    engageTempCharLock()
    if not target or not target.Character then return end
    local myRoot = getMyRootPart()
    if not myRoot then return end

    local theirRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not theirRoot then return end

    local sideKey = getBestSideKey(target)

    local trackingActive = true
    local function calcLiveDashDir()
        local mr = getMyRootPart()
        local tr = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if not mr or not tr then return nil end
        local theirBack = Vector3.new(
            -tr.CFrame.LookVector.X, 0,
            -tr.CFrame.LookVector.Z).Unit
        local angleDeg = sideKey == Enum.KeyCode.A and 90 or -90
        local rad = math.rad(angleDeg)
        return Vector3.new(
            theirBack.X * math.cos(rad) - theirBack.Z * math.sin(rad), 0,
            theirBack.X * math.sin(rad) + theirBack.Z * math.cos(rad)
        ).Unit
    end

    local initDir = calcLiveDashDir()
    if initDir then
        myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + initDir)
        RunService.Heartbeat:Wait()
        myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + initDir)
    end

    lockingAtBack = false

    task.spawn(function()
        while trackingActive do
            RunService.Heartbeat:Wait()
            if not trackingActive then break end
            local mr = getMyRootPart()
            if not mr then break end
            local dir = calcLiveDashDir()
            if dir then
                mr.CFrame = CFrame.new(mr.Position, mr.Position + dir)
            end
        end
    end)

    runOrbitToBack(target, 3, true, nil)

    task.wait(0.016)
    tapBtn(dashBtn)
    task.wait(0.03)
    task.wait(0.03)

    task.delay(0.15, function()
        trackingActive = false
        lockingAtBack  = false
        releaseTempCharLock()
    end)
end

