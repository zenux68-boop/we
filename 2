local function deactivateAnglePrediction()
    if State.comboDashLock then return end
    State.AnglePredActive   = false
    State.AnglePredOrbitDeg = 0
    State.AnglePredDashDir  = nil
    anglePredLockActive     = false
    setReticleColor(CONFIG.ReticleColor)
end

local function activateAnglePrediction(dashDirection, orbitDeg)
    if not State.Locked or not State.Target then return end

    local targetPos = getTargetPosition(State.Target)
    local myRoot    = getMyRootPart()
    if not targetPos or not myRoot then return end

    local dist = (targetPos - myRoot.Position).Magnitude
    if dist >= ANGLEPRED.ActivationRange then return end

    local toTarget = targetPos - myRoot.Position
    local flatFace = Vector3.new(toTarget.X, 0, toTarget.Z)
    if flatFace.Magnitude < 0.01 then
        local lv = myRoot.CFrame.LookVector
        flatFace = Vector3.new(lv.X, 0, lv.Z)
    end
    flatFace = flatFace.Unit

    local rad  = math.rad(orbitDeg)
    local cosR = math.cos(rad)
    local sinR = math.sin(rad)
    local newFaceDir = Vector3.new(
        flatFace.X * cosR - flatFace.Z * sinR,
        0,
        flatFace.X * sinR + flatFace.Z * cosR
    ).Unit

    if FacingAlignOrientation then FacingAlignOrientation.Enabled = false end

    if State.softLockEnabled then
        anglePredLockActive = true
    end

    myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + newFaceDir)

    State.AnglePredActive   = true
    State.AnglePredEndTime  = tick() + ANGLEPRED.ReturnTimer
    State.AnglePredOrbitDeg = orbitDeg
    State.AnglePredDashDir  = dashDirection

    if State.softLockEnabled then
        task.delay(ANGLEPRED.ReturnTimer + 0.05, function()
            anglePredLockActive = false
        end)
    end

    setReticleColor(Color3.fromRGB(255, 200, 0))
end

