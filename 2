    engageTempCharLock()
    flushAllKeys()

    comboInProgress2 = true

    local target  = getClosestLockedTarget()
    local sideKey
    do
        local mr = getMyRootPart()
        local tr = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if mr and tr then
