local function setEvadeFill(player, fraction)
    local data = CDPlayerData[player]
    if not data then return end
    fraction = math.clamp(fraction, 0, 1)
    data.evadeFraction = fraction
    if data.evadeFill then
        data.evadeFill.Size = UDim2.new(1, 0, fraction, 0)
    end
end

local function setAbilityFill(player, index, fraction)
    local data = CDPlayerData[player]
    if not data then return end
    fraction = math.clamp(fraction, 0, 1)
    if data.abilityBars and data.abilityBars[index] then
        local fill = data.abilityBars[index]
        local remaining = 1 - fraction
        fill.AnchorPoint = Vector2.new(0, 1)
        fill.Position    = UDim2.new(0, 0, 1, 0)
        fill.Size        = UDim2.new(1, 0, remaining, 0)
        data.abilities[index].cdFraction = fraction
    end
end

local function startAbilityCooldown(player, index)
    local data = CDPlayerData[player]
    if not data then return end
    local ab = data.abilities[index]
    if not ab then return end
    if ab.cdRunning then return end
    ab.cdRunning  = true
    ab.cdFraction = 0
    setAbilityFill(player, index, 0)

    local duration = ab.maxCd
    local startTime = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not CDPlayerData[player] then conn:Disconnect(); return end
        local elapsed  = tick() - startTime
        local fraction = math.clamp(elapsed / duration, 0, 1)
        setAbilityFill(player, index, fraction)
        if fraction >= 1 then
            ab.cdRunning = false
            conn:Disconnect()
        end
    end)
end

local function initCDPlayer(player)
    if player == LocalPlayer then return end
    if CDPlayerData[player] then return end

    CDPlayerData[player] = {
        evadeFraction = 1,
        evadeFill     = nil,
        gui           = nil,
        abilities     = {},
        abilityBars   = {},
        evadeConn     = nil,
    }

    local function onCharacter(char)
        local data = CDPlayerData[player]
        if not data then return end

        data.evadeFraction = 1
        data.abilities     = {}
        data.abilityBars   = {}

        if data.evadeConn then
            data.evadeConn:Disconnect()
            data.evadeConn = nil
        end

        local root = char:WaitForChild("HumanoidRootPart", 10)
        if not root then return end
        task.wait(2)

        local moveset = char:WaitForChild("Moveset", 5)
        if moveset then
            for _, v in ipairs(moveset:GetChildren()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") or v:IsA("StringValue") then
                    table.insert(data.abilities, {
                        name       = v.Name,
                        maxCd      = v.Value,
                        cdFraction = 1,
                        cdRunning  = false,
                        service    = serviceNameFromAbility(v.Name),
                    })
                end
            end
        end
        if CDTRACK.ENABLED then
            createCDGui(player)
        end

        data.evadeConn = char:GetAttributeChangedSignal("Evade"):Connect(function()
            local val      = char:GetAttribute("Evade") or 0
            local fraction = math.clamp(val / CDTRACK.EVADE_MAX, 0, 1)
            setEvadeFill(player, fraction)
        end)

        local initEvade = char:GetAttribute("Evade") or 0
        setEvadeFill(player, math.clamp(initEvade / CDTRACK.EVADE_MAX, 0, 1))
    end

    if player.Character then
        task.spawn(onCharacter, player.Character)
    end
    player.CharacterAdded:Connect(onCharacter)
    player.CharacterRemoving:Connect(function()
        destroyCDGui(player)
    end)
end

local function cleanupCDPlayer(player)
    local data = CDPlayerData[player]
    if data and data.evadeConn then
        data.evadeConn:Disconnect()
    end
    destroyCDGui(player)
    CDPlayerData[player] = nil
end

local function onAbilityFired(serviceName, firingPlayer)
    local data = CDPlayerData[firingPlayer]
    if not data then return end
    for i, ab in ipairs(data.abilities) do
        if ab.service == serviceName then
            startAbilityCooldown(firingPlayer, i)
            return
        end
    end
end

