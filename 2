    if not c then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    return (h and h.Health > 0) and h or nil
end

local function getTargetPosition(player)
    local c = player.Character
    if not c or not c.PrimaryPart then return nil end
    return c:GetPivot().Position
end

local function getMyRootPart()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function isValidCandidate(player)
    if player == LocalPlayer then return false end
    return player.Character and getHumanoid(player) and getTargetPosition(player) and true or false
