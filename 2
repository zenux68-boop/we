local COMPETING_MOVER_CLASSES = {
    "BodyPosition","BodyVelocity","BodyGyro","BodyForce",
    "BodyAngularVelocity","AlignPosition","AlignOrientation",
    "LinearVelocity","VectorForce",
}
local OUR_OBJECT_NAMES = {
    ViltrumiteFlightVelocity = true,
    ViltrumiteFlightGyro     = true,
}

local function neutralizeCompetingMovers()
    for _, className in ipairs(COMPETING_MOVER_CLASSES) do
        for _, obj in ipairs(rootPart:GetChildren()) do
            if obj.ClassName == className and not OUR_OBJECT_NAMES[obj.Name] then
                if obj:IsA("BodyPosition") or obj:IsA("BodyForce") or obj:IsA("BodyVelocity") then
                    pcall(function() obj.MaxForce = Vector3.new(0,0,0) end)
                elseif obj:IsA("BodyGyro") or obj:IsA("BodyAngularVelocity") then
                    pcall(function() obj.MaxTorque = Vector3.new(0,0,0) end)
                elseif obj:IsA("AlignPosition") or obj:IsA("AlignOrientation") then
                    pcall(function() obj.Enabled = false end)
                elseif obj:IsA("LinearVelocity") then
                    pcall(function() obj.MaxForce = 0 end)
                elseif obj:IsA("VectorForce") then
                    pcall(function() obj.Force = Vector3.new(0,0,0) end)
                end
            end
        end
    end
end

