local poseAlpha = 0

local function applyFlyingPose(dt, speedRatio, hasInput)
    local targetAlpha = hasInput and 1 or 0.85
    poseAlpha = poseAlpha + (targetAlpha - poseAlpha) * math.clamp(dt * 7, 0, 1)

    if hasInput then
        if joints.LeftShoulder  and originalC0.LeftShoulder  then joints.LeftShoulder.C0  = originalC0.LeftShoulder  * CFrame.Angles(0, 0,  poseAlpha * math.rad(30)) end
        if joints.RightShoulder and originalC0.RightShoulder then joints.RightShoulder.C0 = originalC0.RightShoulder * CFrame.Angles(0, 0, -poseAlpha * math.rad(30)) end
        if joints.LeftHip  and originalC0.LeftHip  then joints.LeftHip.C0  = originalC0.LeftHip  * CFrame.Angles(-poseAlpha * math.rad(8), 0, -poseAlpha * math.rad(5)) end
        if joints.RightHip and originalC0.RightHip then joints.RightHip.C0 = originalC0.RightHip * CFrame.Angles(-poseAlpha * math.rad(8), 0,  poseAlpha * math.rad(5)) end
    else
        if joints.LeftShoulder  and originalC0.LeftShoulder  then joints.LeftShoulder.C0  = originalC0.LeftShoulder  * CFrame.Angles(math.rad(55), 0,  math.rad(20)) end
        if joints.RightShoulder and originalC0.RightShoulder then joints.RightShoulder.C0 = originalC0.RightShoulder * CFrame.Angles(math.rad(55), 0, -math.rad(20)) end
        if joints.LeftHip  and originalC0.LeftHip  then joints.LeftHip.C0  = originalC0.LeftHip  * CFrame.Angles(0, 0, -math.rad(5)) end
        if joints.RightHip and originalC0.RightHip then joints.RightHip.C0 = originalC0.RightHip * CFrame.Angles(0, 0,  math.rad(5)) end
    end
    if joints.Waist and originalC0.Waist then joints.Waist.C0 = originalC0.Waist * CFrame.Angles( poseAlpha * math.rad(4),   0, 0) end
    if joints.Neck  and originalC0.Neck  then joints.Neck.C0  = originalC0.Neck  * CFrame.Angles(-poseAlpha * math.rad(20),  0, 0) end
end

local function snapPoseToNeutral()
    poseAlpha = 0
    for name, joint in pairs(joints) do
        if joint and originalC0[name] then joint.C0 = originalC0[name] end
    end
end


