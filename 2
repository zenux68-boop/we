--========================================================================
local function isHandicapRemote(obj)
    if not obj:IsA("RemoteEvent") then return false end
    if obj.Name ~= "Effects" then return false end
    local re = obj.Parent
    if not re or re.Name ~= "RE" then return false end
    local svc = re.Parent
    if not svc or svc.Name ~= "HandicapService" then return false end
    return true
end

local function hookHandicapRemote(remote)
    remote.OnClientEvent:Connect(function(...)
        local args = { ... }

        if args[2] == "Collide" then return end

        if args[2] == "GrabEnd" then
            local myChar = LocalPlayer.Character
            if not myChar then return end
            local myRootArg = args[1]
            if not myRootArg then return end
            local fromChar = myRootArg.Parent
            if not fromChar or fromChar ~= myChar then return end

            local target = getLockedTarget()
            if not target then return end

            task.spawn(function()
                engageTempCharLock()
                while chainEnabled do
                    RunService.Heartbeat:Wait()
                    local mr = getMyRootPart()
                    local tr = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                    if not mr or not tr then break end
                    local toTgt = Vector3.new(
                        tr.Position.X - mr.Position.X, 0,
                        tr.Position.Z - mr.Position.Z)
                    if toTgt.Magnitude > 0.01 then
                        mr.CFrame = CFrame.new(mr.Position, mr.Position + toTgt.Unit)
                        ControlModule.activeController.moveVector = Vector3.new(0, 0, -1)
                    end
                    if toTgt.Magnitude <= 3 then break end
                end
                ControlModule.activeController.moveVector = Vector3.new(0, 0, 0)

                if not chainEnabled then return end

                local tgt = getLockedTarget()
                if not tgt then return end

                fireDivergentFist()

                task.delay(CHAIN_INTERVAL, function()
                    fireDivergentFist()
                    task.delay(0.29, function()
                        State.AnglePredActive  = false
                        State.AnglePredEndTime = 0
                        comboInProgress2       = false
                        comboManualArmed2      = false
                        releaseTempCharLock()
                        task.delay(0.1, function()
                            local c = LocalPlayer.Character
                            local h = c and c:FindFirstChildOfClass("Humanoid")
                            if h then h.AutoRotate = true end
                        end)
                    end)
                end)

                chainSideDash(tgt)
            end)
        end
    end)
end

