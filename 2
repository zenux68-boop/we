local DIRECTION_KEYWORDS = {
    ["left"]     = "Left",
    ["right"]    = "Right",
    ["forward"]  = "Forward",
    ["Chase"]    = "Forward",
    ["chase"]    = "Forward",
    ["back"]     = "Back",
    ["backward"] = "Back",
}

local function findDirectionInArgs(...)
    local args = { ... }
    for i, v in ipairs(args) do
        if type(v) == "string" then
            local lower = v:lower()
            local canon = DIRECTION_KEYWORDS[lower]
            if canon then return canon, i, v end
        end
    end
    local orderedKeywords = {
        {"forwards", "Forward"},
        {"Chase",    "Forward"},
        {"chase",    "Forward"},
        {"backward", "Back"},
        {"right",    "Right"},
        {"left",     "Left"},
        {"back",     "Back"},
    }
    for i, v in ipairs(args) do
        if type(v) == "string" then
            local lower = v:lower()
            for _, pair in ipairs(orderedKeywords) do
                if lower:find(pair[1], 1, true) then
                    return pair[2], i, v
                end
            end
        end
    end
    return nil
end


