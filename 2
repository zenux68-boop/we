-- FIRE COMBO
--========================================================================
local function fireCombo()
    if comboInProgress then return end
    if not State.Locked or not State.Target then return end
    if not isInRange(State.Target, COMBO.Range) then
        comboManualArmed = false
        return
    end

    local myRoot = getMyRootPart()
    local targetPos = getTargetPosition(State.Target)
    if not myRoot or not targetPos then return end

    local theirRoot = State.Target.Character and State.Target.Character:FindFirstChild("HumanoidRootPart")
    if not theirRoot then return end

    local wasSoftLock = State.softLockEnabled
    if wasSoftLock then
        State.softLockEnabled = false
        Camera.CameraType = Enum.CameraType.Scriptable
        local c = LocalPlayer.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h.AutoRotate = false end
        end
    end

    engageTempCharLock()
    flushAllKeys()

    comboInProgress        = true
    State.comboDashLock    = true
    State.AnglePredActive  = true
    State.AnglePredEndTime = math.huge

    task.delay(0.001, function()
        comboM1WindowUntil = tick() + 0.16
        tapM1()
    end)

    local target  = getClosestLockedTarget()
    local sideKey
    do
        local mr = getMyRootPart()
        local tr = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if mr and tr then
            local myRight = Vector3.new(mr.CFrame.RightVector.X, 0, mr.CFrame.RightVector.Z).Unit
            local toTarget = Vector3.new(tr.Position.X - mr.Position.X, 0, tr.Position.Z - mr.Position.Z)
            if toTarget.Magnitude > 0.01 then
                sideKey = (myRight:Dot(toTarget.Unit) >= 0) and Enum.KeyCode.A or Enum.KeyCode.D
            else
                sideKey = LastHeldSide
            end
        else
            sideKey = LastHeldSide
        end
    end

    local dashFaceActive = true

    RunService.Heartbeat:Wait()
    ControlModule.activeController.moveVector = sideKey == Enum.KeyCode.A and Vector3.new(-1, 0, 0) or Vector3.new(1, 0, 0)

    task.spawn(function()
        task.wait(0.015)

        local dashConfirmed = false
        local watchConn
        local startPos

        local char     = LocalPlayer.Character
        local hum      = char and char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")

        local DashAnimations = {
            ["rbxassetid://75203303352791"]  = true,
            ["rbxassetid://117223862448096"] = true,
            ["rbxassetid://117941450906936"] = true,
            ["rbxassetid://77705898607209"]  = true,
        }

        if animator then
            watchConn = animator.AnimationPlayed:Connect(function(track)
                if DashAnimations[track.Animation.AnimationId] then
                    dashConfirmed = true
                    startPos = getMyRootPart() and getMyRootPart().Position
                    if watchConn then watchConn:Disconnect() end
                end
            end)
        end

        -- snap angle and fire dash simultaneously
        do
            local mr = getMyRootPart()
            local tp = target and getTargetPosition(target)
            if mr and tp then
                local toTgt = Vector3.new(tp.X - mr.Position.X, 0, tp.Z - mr.Position.Z)
                if toTgt.Magnitude >= 0.01 then
                    toTgt = toTgt.Unit
                    local angleDeg = (sideKey == Enum.KeyCode.A) and 80 or -80
                    local rad = math.rad(angleDeg)
                    local dashDir = Vector3.new(
                        toTgt.X * math.cos(rad) - toTgt.Z * math.sin(rad),
                        0,
                        toTgt.X * math.sin(rad) + toTgt.Z * math.cos(rad)
                    ).Unit
                    mr.CFrame = CFrame.new(mr.Position, mr.Position + dashDir)
                end
            end
        end

        tapBtn(dashBtn)
        task.wait(0.03)
        task.wait(0.02)
        ControlModule.activeController.moveVector = Vector3.new(0, 0, 0)

        if not animator then return end

        local watchTimeout = tick() + 0.4
        while not dashConfirmed and tick() < watchTimeout do
            RunService.Heartbeat:Wait()
        end

        if not dashConfirmed then
            if watchConn then watchConn:Disconnect() end
            return
        end

        local glideStart    = tick()
        local glideDuration = 0.25

        local glideConn
        glideConn = RunService.Heartbeat:Connect(function()
            local mr = getMyRootPart()
            local tr = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if not mr or not tr or not startPos then glideConn:Disconnect(); return end

            local alpha = math.clamp((tick() - glideStart) / glideDuration, 0, 1)
            local t = 1 - (1 - alpha)^2

            local backDir = Vector3.new(-tr.CFrame.LookVector.X, 0, -tr.CFrame.LookVector.Z).Unit
            local endPos = Vector3.new(
                tr.Position.X + backDir.X * 4,
                mr.Position.Y,
                tr.Position.Z + backDir.Z * 4
            )

            local newPos = Vector3.new(
                startPos.X + (endPos.X - startPos.X) * t,
                mr.Position.Y,
                startPos.Z + (endPos.Z - startPos.Z) * t
            )

            mr.CFrame = CFrame.new(newPos, Vector3.new(tr.Position.X, newPos.Y, tr.Position.Z))
            if alpha >= 1 then glideConn:Disconnect() end
        end)
    end)

    task.spawn(function()
        task.wait(0.15)
        dashFaceActive = false
        ControlModule.activeController.moveVector = Vector3.new(0, 0, -1)
        task.delay(0.1, function() ControlModule.activeController.moveVector = Vector3.new(0, 0, 0) end)
        task.delay(0.12, function()
            State.comboDashLock    = false
            State.AnglePredActive  = false
            State.AnglePredEndTime = 0
            comboInProgress        = false
            comboManualArmed       = false
            if wasSoftLock then
                State.softLockEnabled = true
                Camera.CameraType = Enum.CameraType.Custom
                local c = LocalPlayer.Character
                if c then local h = c:FindFirstChildOfClass("Humanoid") if h then h.AutoRotate = true end end
            end
            releaseTempCharLock()
        end)
        task.delay(0.25, function()
            State.comboDashLock    = false
            State.AnglePredActive  = false
            State.AnglePredEndTime = 0
        end)
    end)

    task.delay(2, function()
        dashFaceActive         = false
        State.comboDashLock    = false
        State.AnglePredActive  = false
        State.AnglePredEndTime = 0
        comboInProgress        = false
        comboManualArmed       = false
        if wasSoftLock then
            State.softLockEnabled = true
            Camera.CameraType = Enum.CameraType.Custom
            local c = LocalPlayer.Character
            if c then local h = c:FindFirstChildOfClass("Humanoid") if h then h.AutoRotate = true end end
        end
        releaseTempCharLock()
        flushAllKeys()
    end)
end

