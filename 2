local function findBestTarget()
    local best, bestScore = nil, math.huge
    local vp     = Camera.ViewportSize
    local sc     = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    local camPos = Camera.CFrame.Position
    local camFwd = Camera.CFrame.LookVector

    for _, p in ipairs(Players:GetPlayers()) do
        if isValidCandidate(p) then
            local tp  = getTargetPosition(p)
            local off = tp - camPos
            local d   = off.Magnitude
            if d <= CONFIG.MaxLockDistance then
                local ang = math.deg(math.acos(math.clamp(camFwd:Dot(off.Unit), -1, 1)))
                if ang <= CONFIG.MaxLockAngle then
                    local sp, on = Camera:WorldToViewportPoint(tp)
                    if on then
                        local sd = (Vector2.new(sp.X, sp.Y) - sc).Magnitude
                        local s  = sd + d * 0.01
                        if s < bestScore then bestScore = s; best = p end
                    end
                end
            end
        end
    end
    return best
end

