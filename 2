local function serviceNameFromAbility(abilityName)
    return abilityName:gsub("%s+", "") .. "Service"
end

local function getCDRoot(player)
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function destroyCDGui(player)
    local data = CDPlayerData[player]
    if not data then return end
    if data.gui then
        data.gui:Destroy()
        data.gui = nil
    end
    data.abilityBars = {}
    data.evadeFill   = nil
end

local function distanceToCDPlayer(player)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return math.huge end
    local root = getCDRoot(player)
    if not root then return math.huge end
    return (myRoot.Position - root.Position).Magnitude
end

