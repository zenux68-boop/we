  <script>
    // ══════════════════════════════════════════════════════════════════════════
    // Kali Hub key system — client.
    //
    // The client owns nothing that matters: every timer here is cosmetic and is
    // re-checked server-side against the server clock before a key is minted. It
    // holds one HMAC-signed token it cannot forge, and asks the server to advance
    // the state machine one step at a time.
    // ══════════════════════════════════════════════════════════════════════════

    const ENDPOINT    = 'keysystem.php';
    // The signed funnel token and its display state survive navigation back from Premium.
    // The server still validates the token on every state-changing request.
    const KEY_STORAGE  = 'kali_active_key';  // shared with the other key pages
    const FLOW_STORAGE = 'kali_flow_state';
    const LOCKR_RETURN_TOKEN = 'b015cc1fbf8f65580e77f7e16357b53bf46f';
    const ADSTERRA_SRC = 'https://strengthdetention.com/e6/a8/4a/e6a84a06ddc67bc2cf44093bf636f8ce.js';
    const TURNSTILE_SITEKEY = '0x4AAAAAAD6j_nCeEONsamGX';

    // ─── Plans ────────────────────────────────────────────────────────────────
    // SellAuth checkout links need an explicit variantId, so each plan carries its own.
    // `price`/`unit` are display only — they must be kept in step with the store by hand,
    // since the storefront cannot be read from here.
    const PLANS = [
      {
        id: 'weekly',
        name: 'Weekly',
        sub: '7 days · about R$2.29 daily',
        badge: 'MOST BOUGHT',
        price: 'R$16',
        amount: 16,        // base amount in BASE_CURRENCY (see localizePrices)
        unit: '/weekly',
        url: 'https://kalihub.mysellauth.com/checkout-link?cart[0][productId]=521548&cart[0][variantId]=791739&cart[0][quantity]=1'
      },
      {
        id: 'monthly',
        name: 'Monthly',
        sub: '30 days · about R$7 a week',
        badge: '',
        tag: 'BEST VALUE',
        price: 'R$32',
        amount: 32,
        unit: '/monthly',
        url: 'https://kalihub.mysellauth.com/checkout-link?cart[0][productId]=521548&cart[0][variantId]=791751&cart[0][quantity]=1'
      }
    ];
    let selectedPlan = 0;

    // Safari with "Block All Cookies" throws on ANY localStorage access, even a bare read,
    // so nothing here touches it directly — the funnel still works in memory for the page.
    const mem = {};
    function lsGet(k) { try { const v = localStorage.getItem(k); if (v !== null) return v; } catch (_) {} return k in mem ? mem[k] : null; }
    function lsSet(k, v) { mem[k] = v; try { localStorage.setItem(k, v); } catch (_) {} }
    function lsDel(k) { delete mem[k]; try { localStorage.removeItem(k); } catch (_) {} }

    function saveFlowState() {
      if (!state.token || !state.offers.length) return;
      lsSet(FLOW_STORAGE, JSON.stringify({
        token: state.token,
        offers: state.offers,
        progress: state.progress,
        waitlistSec: state.waitlistSec,
        waitLeft: state.waitLeft,
        waitStarted: state.waitStarted,
        allDone: state.allDone,
        proof: state.proof,
        skew: state.skew,
        planShown: state.planShown
      }));
    }

    function restoreFlowState() {
      try {
        const raw = lsGet(FLOW_STORAGE);
        if (!raw) return false;
        const saved = JSON.parse(raw);
        if (!saved || typeof saved.token !== 'string' || !saved.token ||
            !Array.isArray(saved.offers) || !saved.offers.length ||
            saved.offers.length !== 2 || !Array.isArray(saved.progress) || saved.progress.length !== saved.offers.length) {
          lsDel(FLOW_STORAGE);
          return false;
        }
        state.token = saved.token;
        state.offers = saved.offers;
        state.progress = saved.progress;
        state.waitlistSec = typeof saved.waitlistSec === 'number' ? saved.waitlistSec : 120;
        state.waitLeft = typeof saved.waitLeft === 'number' ? saved.waitLeft : state.waitlistSec;
        state.waitStarted = !!saved.waitStarted;
        state.allDone = !!saved.allDone;
        state.proof = typeof saved.proof === 'string' ? saved.proof : '';
        state.skew = typeof saved.skew === 'number' ? saved.skew : 0;
        state.planShown = !!saved.planShown;
        return true;
      } catch (_) {
        lsDel(FLOW_STORAGE);
        return false;
      }
    }

    let state = {
      token: null, offers: [], progress: [],
      waitlistSec: 120, waitLeft: 120, waitStarted: false,
      allDone: false, proof: '', skew: 0,
      planShown: false, busy: false, keyDone: false, banned: false
    };

    // ─── API ──────────────────────────────────────────────────────────────────
    async function api(action, extra) {
      if (state.banned) return null;
      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.assign({ action: action, nav_ref: document.referrer || '' }, extra || {}))
        });
        const j = await res.json();
        if (j && typeof j === 'object') j.code = res.status;   // let callers see the HTTP status
        // A block ends the page wherever it is reached — the funnel tab, the Bstlar return
        // tab, even the key screen — so it is handled once, here, instead of at every call.
        if (j && j.banned) { showBan(j); return null; }
        return j;
      } catch (_) { return null; }
    }

    // ─── Blocked ──────────────────────────────────────────────────────────────
    // The server blocks a browser only on signals an honest one cannot produce (see the ban
    // section in keysystem.php). Nothing here can be dismissed: the curtain stays up, the
    // ticker stops, and the countdown runs until the block lifts.
    let banTimer = null;
    function showBan(d) {
      state.banned = true;
      state.busy = true;
      clearInterval(banTimer);
      clearInterval(keyTimer);
      clearInterval(keyWatch);

      const until = (d && typeof d.until === 'number') ? d.until * 1000 : 0;
      const base  = (d && d.message) || 'Access temporarily blocked.';

      const paint = function () {
        const left = until ? until - Date.now() : 0;
        if (until && left <= 0) {
          clearInterval(banTimer);
          state.banned = false;                     // let the retry actually re-enter boot()
          gateShow('Block expired', 'You can start the key system again.', { retry: true });
          return;
        }
        gateShow('Access blocked', until ? base + ' Lifts in ' + fmtLong(left / 1000) + '.' : base,
                 { premium: true });
      };
      paint();
      banTimer = setInterval(paint, 1000);
    }

    function fmtLong(sec) {
      sec = Math.max(0, Math.floor(sec));
      const h = Math.floor(sec / 3600), m = Math.floor(sec / 60) % 60, s = sec % 60;
      return (h > 0 ? h + 'h ' : '') + (h > 0 || m > 0 ? m + 'm ' : '') + s + 's';
    }

    // Every response that carries state carries the whole state, so there is one place
    // that applies it.
    function applyState(d) {
      if (!d) return;
      if (d.flow_token) state.token = d.flow_token;
      if (typeof d.now === 'number') state.skew = d.now * 1000 - Date.now();
      if (Array.isArray(d.offers) && d.offers.length) state.offers = d.offers;
      if (Array.isArray(d.progress)) state.progress = d.progress;
      if (typeof d.waitlist_sec === 'number') state.waitlistSec = d.waitlist_sec;
      state.allDone = !!d.all_done;
      if (d.wait_started && typeof d.wait_left === 'number') {
        state.waitStarted = true;
        state.waitLeft = d.wait_left;          // the server's count is the real one
      }
      if (d.verify_proof) state.proof = d.verify_proof;
      saveFlowState();
      render();
    }

    function serverNow() { return Date.now() + state.skew; }

    // ─── Browser integrity signals ────────────────────────────────────────────
    // Reported to the server, which decides. Two independent ad-block tells: the bait
    // element (filter lists hide it by class name) and the ad script failing to load.
    // Brave only counts when something is actually being blocked — Shields down still
    // reports isBrave(), and a user who complied must not be punished for it.
    async function collectSignals() {
      const s = { webdriver: false, headless: false, adblock: false, brave: false, incognito: false, userscript: false };

      try { s.webdriver = navigator.webdriver === true; } catch (_) {}

      // Userscript manager (Tampermonkey / Greasemonkey / Violentmonkey). None expose a page
      // global by design, so this reads the side effects they leave in the page: a sandbox
      // global that leaked, or the extension-injected marker nodes they add at document-start.
      // ponytail: weakest signal of the set — a manager configured to inject nothing shows
      // nothing here. The real defence against their bypass scripts is the server timing gates.
      try {
        if (typeof window.GM_info !== 'undefined' || typeof window.GM !== 'undefined' ||
            typeof unsafeWindow !== 'undefined' || typeof window.GM_setValue === 'function' ||
            document.querySelector('script[id^="tampermonkey"], script[data-source="greasemonkey"], div.tm-mount, #greasemonkey')) {
          s.userscript = true;
        }
      } catch (_) {}

      // Private / Incognito. In a Chromium private window the temporary-storage quota is
      // capped to a small multiple of the JS heap limit, while a normal window's quota tracks
      // the disk and is far larger. Comparing the two is the method that still works on
      // current Chrome and Brave (both Blink, both expose performance.memory). Low false
      // positive: a normal browser's quota is tens of GB, well above heap×2 (~4GB).
      // ponytail: a device with only a few GB of free disk could dip near the threshold in a
      // normal window. Firefox/Safari private are attempted separately below.
      s.incognito = await detectIncognito();

      try {
        const ua = navigator.userAgent || '';
        const claimsChrome = /Chrome\//.test(ua) && !/Edg\/|OPR\//.test(ua);
        const noChromeObj  = claimsChrome && typeof window.chrome === 'undefined';
        const noLangs      = !navigator.languages || navigator.languages.length === 0;
        const noPlugins    = !navigator.plugins || navigator.plugins.length === 0;
        // All three at once is the classic headless fingerprint; any one alone is a
        // hardened-but-real browser, which must still get its key.
        s.headless = noChromeObj && noLangs && noPlugins;
      } catch (_) {}

      try { if (navigator.brave && typeof navigator.brave.isBrave === 'function') s.brave = await navigator.brave.isBrave(); } catch (_) {}

      s.adblock = await detectAdblock();

      return s;
    }

    // ─── Ad-blocker detection (universal, multi-vector, vote ≥2) ────────────────
    // Aims to catch every method — extension blockers (uBlock incl. MV3 Lite, AdBlock Plus,
    // AdGuard, Ghostery), browser-native (Brave Shields, Opera, Safari content blockers) and
    // network-level (Pi-hole, NextDNS, AdGuard DNS, corporate filters) — across every browser.
    // No single signal is trusted: independent vectors run and a block is declared only when
    // at least TWO agree, so one flaky failure (a slow CDN, a hiccup) never blocks a real user.
    //   1. DOM cosmetic bait — baits wearing EasyList ad classes, read AFTER a 200ms delay so
    //      the blocker's cosmetic filter has run (reading immediately is why Brave slipped by).
    //   2. Self-hosted /ads.js — first-party, returns 200 (no 404 FP), but its path is on every
    //      network list, so a blocker refuses it while a clean browser loads it. First-party
    //      means a proxy that blocks doubleclick alone cannot false-positive here.
    //   3+4. TWO independent third-party canary groups. A DNS blocker resolves no ad host, so
    //      it trips BOTH groups (two votes) and is caught even though it applies no cosmetic
    //      filter and can't touch our first-party /ads.js. A single transient host failure
    //      trips at most one group, so it never blocks on its own.
    // Everything is fetch/DOM, never an executed ad <script>, so nothing pops before the
    // captcha. Every network probe races a 4s timeout and fails OPEN, so an offline user is
    // never wrongly blocked.
    async function detectAdblock() {
      const probe = function (url, opts) {
        return Promise.race([
          fetch(url, Object.assign({ cache: 'no-store' }, opts || {})).then(function () { return false; }, function () { return true; }),
          new Promise(function (r) { setTimeout(function () { r(false); }, 4000); })   // offline: fail open
        ]);
      };
      const anyBlocked = function (urls) {
        return Promise.all(urls.map(function (u) { return probe(u, { mode: 'no-cors' }); }))
          .then(function (r) { return r.indexOf(true) !== -1; });
      };

      // Vector 1: DOM cosmetic baits — the static one plus two runtime baits with different
      // EasyList class combos, read after a 200ms delay so the cosmetic filter has run.
      const domVote = (async function () {
        try {
          const baits = [document.getElementById('ad-banner-bait')];
          [['ad-banner', 'adsbox', 'doubleclick', 'ad-placement'],
           ['pub_300x250', 'sponsored', 'banner_ads', 'adsbygoogle']].forEach(function (classes) {
            const el = document.createElement('div');
            el.className = classes.join(' ');
            el.style.cssText = 'position:absolute;left:-9999px;top:-9999px;width:300px;height:250px';
            el.innerHTML = '&nbsp;';
            document.body.appendChild(el);
            baits.push(el);
          });
          await new Promise(function (r) { setTimeout(r, 200); });
          return baits.some(function (el) {
            if (!el) return false;
            const cs = getComputedStyle(el);
            return el.offsetParent === null || el.offsetHeight === 0 || cs.display === 'none' || cs.visibility === 'hidden';
          });
        } catch (_) { return true; }
      })();

      // Vector 2: self-hosted /ads.js (first-party, exists → no 404 FP; path is on every list).
      const selfVote = probe('ads.js?_=' + Date.now());

      // Vectors 3 & 4: two independent canary groups drawn from the ad hosts every list ships.
      // Each group is one vote (any host in it blocked), so a DNS blocker that resolves no ad
      // host trips both and is caught with no cosmetic or first-party signal at all.
      const canaryA = anyBlocked([
        'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js',
        'https://googleads.g.doubleclick.net/pagead/id',
        'https://www.googletagservices.com/tag/js/gpt.js'
      ]);
      const canaryB = anyBlocked([
        'https://static.doubleclick.net/instream/ad_status.js',
        'https://c.amazon-adsystem.com/aax2/apstag.js',
        'https://cdn.adsafeprotected.com/iasPET.1.js'
      ]);

      // All vectors run concurrently, so the whole check is capped at the 4s probe timeout.
      const results = await Promise.all([domVote, selfVote, canaryA, canaryB]);
      const votes = results.filter(Boolean).length;
      return votes >= 2;   // two independent signals must agree — near-zero false positives
    }

    // Chromium incognito detector (Chrome + Brave), desktop and mobile.
    //
    // Desktop Chrome exposes performance.memory, so the storage quota is compared to the JS
    // heap limit — a private window's quota is far smaller. Mobile Chrome has NO
    // performance.memory, so it falls back to an absolute quota threshold: a private window
    // there is capped to a small quota while a normal window's tracks the disk (many GB).
    // Any failure or a non-Chromium engine resolves false — it never blocks on uncertainty.
    //
    // ponytail: the mobile fallback is a heuristic — a phone with very little free space could
    // report a low quota in a normal window too (false positive), and the newest Chrome has
    // been narrowing the private-mode quota gap, so a future version may slip through. Tune
    // INCOGNITO_MOBILE_QUOTA if either shows up. No client signal detects mobile incognito
    // with zero false positives; the server-side block stays the enforcement point.
    const INCOGNITO_MOBILE_QUOTA = 1200 * 1024 * 1024;   // ~1.2 GB
    function detectIncognito() {
      return new Promise(function (resolve) {
        const quotaCb = function (quota) {
          try {
            if (performance && performance.memory && performance.memory.jsHeapSizeLimit) {
              resolve(quota < performance.memory.jsHeapSizeLimit * 2);       // desktop
            } else {
              resolve(quota > 0 && quota < INCOGNITO_MOBILE_QUOTA);          // mobile fallback
            }
          } catch (_) { resolve(false); }
        };
        try {
          const temp = navigator.webkitTemporaryStorage;
          if (temp && temp.queryUsageAndQuota) {
            temp.queryUsageAndQuota(function (_u, quota) { quotaCb(quota); }, function () { resolve(false); });
            return;
          }
          if (navigator.storage && navigator.storage.estimate) {
            navigator.storage.estimate().then(function (est) { quotaCb(est.quota || 0); }, function () { resolve(false); });
            return;
          }
        } catch (_) {}
        resolve(false);
      });
    }

    // ─── Gate ─────────────────────────────────────────────────────────────────
    function gateShow(title, msg, opts) {
      // While a block is up it owns the gate: a stray "Something went wrong" from an in-flight
      // request must not paint over the reason the user is actually stuck.
      if (state.banned && title !== 'Access blocked') return;
      opts = opts || {};
      const g = document.getElementById('gate');
      g.classList.remove('hidden'); g.classList.add('flex');
      document.getElementById('gate-title').innerText = title;
      document.getElementById('gate-msg').innerText = msg;
      document.getElementById('gate-spinner').classList.toggle('hidden', !opts.spinner);
      document.getElementById('gate-retry').classList.toggle('hidden', !opts.retry);
      document.getElementById('gate-premium').classList.toggle('hidden', !opts.premium);
      const cf = document.getElementById('gate-turnstile');
      cf.classList.toggle('hidden', !opts.captcha);
      cf.classList.toggle('flex', !!opts.captcha);
    }

    function gateHide() {
      document.getElementById('gate').classList.add('hidden');
      document.getElementById('app').classList.remove('hidden');
    }

    // ─── Turnstile ─────────────────────────────────────────────────────────────
    // Turnstile tokens are single-use and short-lived, so the widget is rendered only when
    // the gate actually shows the captcha (into a VISIBLE container — rendering into a hidden
    // one is why it sometimes never appeared) and a FRESH token is minted on every attempt
    // via reset(). The one shared callback funnels its token to whichever request is waiting.
    let cfWidgetId = null;
    let cfToken = '';
    let cfResolve = null;
    function cfDeliver(t) { cfToken = t || ''; if (cfResolve) { const r = cfResolve; cfResolve = null; r(cfToken); } }

    // Waits for api.js to define window.turnstile. Resolves false if it never arrives — iOS
    // content blockers and Lockdown Mode drop the request, and the user must not be trapped.
    function turnstileReady() {
      return new Promise(function (resolve) {
        if (window.turnstile && window.turnstile.render) return resolve(true);
        let waited = 0;
        const iv = setInterval(function () {
          if (window.turnstile && window.turnstile.render) { clearInterval(iv); resolve(true); }
          else if ((waited += 100) >= 8000) { clearInterval(iv); resolve(false); }
        }, 100);
      });
    }

    // Renders the widget the first time, resets it (new token) after that, and resolves with
    // the token. No artificial timeout once it is on screen: a managed challenge may need a
    // click, and the callback fires when the user — or the invisible check — completes it.
    async function getCaptchaToken() {
      if (!(await turnstileReady())) return '';        // script blocked: fail open, server decides
      cfToken = '';
      return await new Promise(function (resolve) {
        cfResolve = resolve;
        try {
          if (cfWidgetId === null) {
            cfWidgetId = turnstile.render('#gate-turnstile', {
              sitekey: TURNSTILE_SITEKEY,
              theme: 'dark',
              callback: cfDeliver,
              'error-callback':   function () { cfDeliver(''); },
              'expired-callback': function () { cfToken = ''; },
              'timeout-callback': function () { cfDeliver(''); }
            });
          } else {
            turnstile.reset(cfWidgetId);
          }
        } catch (_) { cfDeliver(''); }
      });
    }

    // ─── Bstlar return ────────────────────────────────────────────────────────
    // Bstlar redirects the offer tab back here with the API key it minted for this visitor
    // (?bk=) and the session id Link Override wrote into the destination (?sid=). This tab
    // holds no funnel state — it only reports the pair, and the server does the proving: the
    // key is validated with Bstlar against this visitor's IP, spent once, and the navigation
    // has to have come from Bstlar. The funnel tab is still polling and picks the step up on
    // its own.
    function clearReturnQuery() {
      try { history.replaceState({}, document.title, location.pathname); } catch (_) {}
    }

    async function lockrReturn(returnToken) {
      if (returnToken !== LOCKR_RETURN_TOKEN) {
        clearReturnQuery();
        gateShow('Could not verify', 'Invalid Lockr return.', { retry: true, premium: true });
        return;
      }
      if (!restoreFlowState()) {
        clearReturnQuery();
        gateShow('Could not verify', 'Return to the active Lockr flow and complete the locker.', { retry: true, premium: true });
        return;
      }

      gateShow('Verifying', 'Confirming your completion with Lockr...', { spinner: true });
      const d = await api('lockr_done', { flow_token: state.token, return_token: returnToken });
      if (d && d.success) {
        const next = await api('offer_done', { flow_token: state.token, i: 1 });
        if (next) applyState(next);
        gateShow('Step completed', 'You can close this tab - your key system tab has already continued.', {});
        setTimeout(function () { try { window.close(); } catch (_) {} }, 1500);
        clearReturnQuery();
        return;
      }
      clearReturnQuery();
      gateShow('Could not verify', (d && d.message) || 'Please complete the Lockr locker again to continue.', { retry: true, premium: true });
    }

    async function bstlarReturn(bk, sid) {
      gateShow('Verifying', 'Confirming your completion with Boostellar…', { spinner: true });
      const d = await api('bstlar_done', { bk: bk, sid: sid });

      if (d && d.success) {
        gateShow('Step completed', 'You can close this tab — your key system tab has already continued.', {});
        // Only a script-opened tab may close itself, which this one is; if the browser
        // refuses, the message above is the whole instruction.
        setTimeout(function () { try { window.close(); } catch (_) {} }, 1500);
        return;
      }
      gateShow('Could not verify', (d && d.message) || 'Please complete the link again to continue.',
               { retry: true, premium: true });
    }

    // ─── Boot ─────────────────────────────────────────────────────────────────
    async function boot() {
      const q = new URLSearchParams(location.search);
      if (q.get('lk_return') === LOCKR_RETURN_TOKEN) return lockrReturn(q.get('lk_return'));
      if (q.get('bk')) return bstlarReturn(q.get('bk'), q.get('sid') || '');

      gateShow('Kali Hub', 'Checking your browser…', { spinner: true });
      // boot() is also the "Try again" button. Restore a saved session first; expired or
      // invalid sessions are cleared by the server through the normal restart path.
      state.token = null; state.proof = ''; state.allDone = false;
      state.waitStarted = false; state.busy = false;
      state.offers = []; state.progress = []; state.planShown = false; state.skew = 0;
      unlockSpin = null; beatsSinceSync = 0; lastSig = '';
      renderPlans();

      // A key from an earlier run is still valid: no captcha, no session, no offers call —
      // the funnel exists to produce this key and it already has one. Refresh, closed tab
      // or new tab all land here.
      const active = getStoredKey();
      if (active) {
        // The stored countdown is only a display. Luarmor decides whether the key still
        // works — it can be deleted, banned or shortened in the panel at any time, and the
        // funnel has to start over when that happens.
        const live = await api('key_check', { user_key: active.key });
        if (live && live.active === false) {
          lsDel(KEY_STORAGE);                       // dead upstream: fall through to the funnel
        } else {
          if (live && live.expire_at) {             // Luarmor's expiry wins over ours
            active.expireAt = live.expire_at * 1000;
            saveKey(active.key, active.expireAt);
          }
          gateHide();
          showKey(active.key, active.expireAt);
          return;
        }
      }

      if (restoreFlowState()) {
        gateHide();
        startDevtoolsWatch();
        render();
        tick();
        return;
      }

      const signals = await collectSignals();
      // Client-side short-circuit for instant feedback. The server re-checks all of these on
      // init, so a tampered client that lies here is still blocked there.
      const clientBlock = signalMessage(signals);
      if (clientBlock) { gateShow(clientBlock[0], clientBlock[1], { retry: true, premium: true }); return; }

      // Show the captcha in its visible container, then mint a fresh single-use token.
      gateShow('Kali Hub', 'Complete the verification to start.', { captcha: true });
      const token = await getCaptchaToken();
      gateShow('Kali Hub', 'Loading your steps…', { spinner: true });

      // One init, one token. The server retries the Bstlar call internally, so there is no
      // client retry loop here — retrying would resend this now-spent token and Turnstile
      // would reject it as already used. A genuine failure sends the user to "Try again",
      // which re-enters boot() and reset()s the widget for a brand new token.
      const d = await api('init', { cf_token: token, signals: signals });

      if (!d || !d.success) {
        const title = (d && (d.blocked === 'vpn' || d.blocked === 'incognito' || d.blocked === 'userscript'))
          ? 'Cannot continue' : 'Something went wrong';
        gateShow(title, (d && d.message) || 'Could not reach the key server. Please try again.', { retry: true, premium: true });
        return;
      }

      applyState(d);
      gateHide();
      startDevtoolsWatch();
      tick();
    }

    // The message a set of signals earns, or null to let it through. Mirrors the server's
    // kali_ks_signal_block precedence so client and server agree on what wins.
    function signalMessage(s) {
      if (s.webdriver || s.headless) return ['Automated browser detected', 'Please open this page in a normal browser to get your key.'];
      if (s.userscript) return ['Userscript extension detected', 'Disable Tampermonkey / Greasemonkey for this site and reload — they are not allowed here.'];
      if (s.incognito)  return ['Private window not supported', 'Open this page in a normal (non-Incognito) window and try again.'];
      if (s.adblock) {
        return ['Ad blocker detected', 'Disable your ad blocker for this site and try again — the ads are what keep this key system free.'];
      }
      return null;
    }

    // Seconds between "has Bstlar reported this session yet?" polls. Coming back to this tab
    // asks immediately, so the wait is only ever this long while the user is somewhere else.
    const POLL_EVERY = 3;
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) pollBeats = POLL_EVERY;
    });

    // ─── Steps ────────────────────────────────────────────────────────────────
    // A step is: idle -> (click: the Bstlar link opens in its own tab) -> waiting
    // for Bstlar -> verified. Completion is real now: the step only flips once the tab Bstlar
    // redirected back has had its API key validated server-side, so the spinner here is
    // waiting on the other tab, not on a clock.
    //
    // Popunder (Adsterra). loadPopunder() fires exactly once in the whole flow —
    // the first time an offer is opened (openStep) — because that is the only moment the user
    // is already leaving for another tab, so a pop underneath costs nothing and never touches
    // the arrival screen, the waitlist, the key, or the Premium CTA. Nothing fires before the
    // captcha; the ad-block probe fetches an ad host instead of executing it, so the gate
    // stays clean.
    //
    // Each script installs a document-wide click handler that pops on the user's gestures, so
    // it is injected ONCE and then left to the network's own frequency cap to throttle. Loading
    // it repeatedly stacks handlers and pops on nearly every click — which is exactly what
    // "keeps firing" looks like — so the guard below is what keeps it strategic, not spammy.

    // ─── Anti-devtools ─────────────────────────────────────────────────────────
    // Detection is the window-size delta: an open, docked DevTools panel shrinks the viewport
    // well below the outer window. Zoom scales both together so it does not trip this, which
    // keeps false positives near zero. While tools look open, a curtain covers the page and
    // the waitlist freezes (pageIsActive() also gates the timer).
    // ponytail: catches docked DevTools; an undocked (separate-window) panel does not change
    // the size and slips past. The blocked shortcuts below raise the effort for everyone else.
    // Nothing here is a security boundary — the server timing gates are.
    let devtoolsOpen = false;
    function devtoolsLikelyOpen() {
      try {
        const wThreshold = 170, hThreshold = 170;
        const widthGap  = (window.outerWidth  - window.innerWidth);
        const heightGap = (window.outerHeight - window.innerHeight);
        // outerHeight always exceeds innerHeight by the browser chrome, so only a gap well
        // past the normal toolbar height counts.
        return widthGap > wThreshold || heightGap > hThreshold + 40;
      } catch (_) { return false; }
    }
    function startDevtoolsWatch() {
      const wall = document.getElementById('devtools-wall');
      const paint = function () {
        const open = devtoolsLikelyOpen();
        if (open === devtoolsOpen) return;
        devtoolsOpen = open;
        wall.classList.toggle('hidden', !open);
        wall.classList.toggle('flex', open);
      };
      paint();
      setInterval(paint, 800);
      window.addEventListener('resize', paint);
    }

    // Shortcut deterrence: F12, Ctrl/Cmd+Shift+I/J/C, Ctrl/Cmd+U. Cheap, defeatable, and
    // deliberately not applied to inputs so copying the key with Ctrl+C still works.
    document.addEventListener('keydown', function (e) {
      const k = (e.key || '').toLowerCase();
      const mod = e.ctrlKey || e.metaKey;
      if (k === 'f12' ||
          (mod && e.shiftKey && (k === 'i' || k === 'j' || k === 'c')) ||
          (mod && k === 'u')) {
        e.preventDefault();
      }
    });

    // Arm Adsterra once per page load. After this, its own click handler and frequency cap
    // decide when a pop actually shows — we do not re-inject and do not wipe its cap, so it
    // stays throttled. A flow reset is a full page reload, which re-arms.
    let adsArmed = false;
    function loadPopunder() {
      if (adsArmed) return;
      adsArmed = true;
      try {
        const a = document.createElement('script');
        a.src = ADSTERRA_SRC;
        document.body.appendChild(a);
      } catch (_) {}
    }

    function stepIcon(p) {
      if (p && p.done) return '<i class="fas fa-check"></i>';
      if (p && p.opened) return '<i class="fas fa-circle-notch fa-spin"></i>';
      return '<i class="fas fa-chevron-right"></i>';
    }

    // The step list is rebuilt only when something structural changes — a rebuild every
    // second would restart every spinner animation. The countdowns update in place.
    let lastSig = '';
    function render() {
      const sig = JSON.stringify([
        state.offers.map(function (o) { return o.title; }),
        state.progress.map(function (p) { return (p.opened ? 1 : 0) + '' + (p.done ? 1 : 0); }),
        state.allDone, waitLeft() === 0, !!state.proof
      ]);
      if (sig !== lastSig) { lastSig = sig; renderSteps(); }
      renderStatus();
    }

    function renderSteps() {
      const rows = state.offers.map(function (o, idx) {
        const n = idx + 1;
        const p = state.progress[idx];
        const done = !!(p && p.done);
        const locked = n > 1 && !(state.progress[idx - 1] && state.progress[idx - 1].done);
        const pending = !!(p && p.opened && !p.done);
        return '<button type="button" class="step' + (done ? ' is-done' : (locked ? ' is-locked' : (pending ? ' is-active' : ''))) + '" data-step="' + n + '"' + (done || locked ? ' disabled' : '') + '>' +
                 '<span class="step-num">' + n + '</span>' +
                 '<span class="step-body">' +
                   '<span class="step-title">' + esc(o.title) + '</span>' +
                   '<span class="step-desc">' + esc(o.desc) + '</span>' +
                 '</span>' +
                 '<span class="step-state">' + stepIcon(p) + '</span>' +
               '</button>';
      }).join('');

      // The final row exists only once every offer is verified — before that there is
      // nothing to wait for and nothing to show.
      const waitRow = !state.allDone ? '' :
        '<div class="step is-active">' +
          '<span class="step-num">' + (state.offers.length + 1) + '</span>' +
          '<span class="step-body">' +
            '<span class="step-title">Wait, or never do this again</span>' +
            '<span class="step-desc">Unlock is ready when the timer finishes</span>' +
          '</span>' +
          '<span class="step-state">' +
            (waitLeft() > 0 ? '<i class="fas fa-circle-notch fa-spin"></i>' : '<i class="fas fa-check" style="color:var(--green)"></i>') +
          '</span>' +
        '</div>';

      document.getElementById('steps').innerHTML = rows + waitRow;
      document.getElementById('waitbar').classList.toggle('hidden', !state.allDone);
    }

    // Waitlist strip + Proceed, repainted every second.
    function renderStatus() {
      if (state.busy || state.keyDone || !state.allDone) return;
      const btn   = document.getElementById('proceed-btn');
      const label = document.getElementById('proceed-label');
      const wt    = document.getElementById('wait-text');
      const left  = waitLeft();

      if (left > 0) {
        document.getElementById('waitpill').classList.remove('hidden');
        wt.innerHTML = 'You are on the waitlist: <span class="count"><span class="emoji">&#9203;</span> Unlocks in ' + fmt(left) + '</span>';
        btn.disabled = true;
        btn.classList.remove('ready');
        btn.querySelector('i').className = 'fas fa-lock text-[10px]';
        label.innerText = 'Unlock key';
        return;
      }

      // Timer done. The strip says nothing — the button itself carries the news: a short
      // spin, then it lights up.
      document.getElementById('waitpill').classList.add('hidden');
      if (unlockSpin === null) {
        unlockSpin = setTimeout(function () { unlockSpin = 'done'; renderStatus(); }, 2400);
      }
      if (unlockSpin !== 'done' || !state.proof) {
        btn.disabled = true;
        btn.classList.remove('ready');
        btn.querySelector('i').className = 'fas fa-circle-notch fa-spin text-[10px]';
        label.innerText = '';
        return;
      }
      btn.disabled = false;
      btn.classList.add('ready');
      btn.querySelector('i').className = 'fas fa-lock-open text-[10px]';
      label.innerText = 'Unlock key';
    }

    // null = not started, a timeout id = spinning, 'done' = the button is live.
    let unlockSpin = null;

    function waitLeft() {
      return state.waitStarted ? Math.max(0, state.waitLeft) : state.waitlistSec;
    }

    // The waitlist only runs while this page is the thing the user is looking at: another
    // tab, another window, a minimised browser or a locked phone all stop it. visibility
    // covers tab switches and mobile backgrounding; hasFocus covers alt-tabbing to another
    // app with the page still on screen.
    function pageIsActive() {
      if (devtoolsOpen) return false;                    // the curtain is up; do not credit time
      if (document.visibilityState !== 'visible') return false;
      return typeof document.hasFocus === 'function' ? document.hasFocus() : true;
    }

    function fmt(sec) {
      sec = Math.max(0, Math.floor(sec));
      const m = Math.floor(sec / 60), s = sec % 60;
      return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    }

    function esc(str) {
      return String(str == null ? '' : str).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function showError(msg) {
      const el = document.getElementById('flow-error');
      el.innerText = msg;
      el.classList.remove('hidden');
      setTimeout(function () { el.classList.add('hidden'); }, 6000);
    }

    document.getElementById('steps').addEventListener('click', function (e) {
      const row = e.target.closest('[data-step]');
      if (row) openStep(parseInt(row.getAttribute('data-step'), 10));
    });

    async function openStep(n) {
      const o = state.offers[n - 1];
      const p = state.progress[n - 1];
      if (!o || (p && p.done) || state.busy) return;
      if (n > 1 && !(state.progress[n - 2] && state.progress[n - 2].done)) {
        showError('Complete Lockr first to unlock Boostellar.');
        return;
      }

      // The popup blocker only allows a window opened synchronously inside the click. Open a
      // blank tab now, validate the session, then navigate it to the third-party URL. This
      // prevents a stale restored link from stranding the user on Bstlar before the server can
      // reject its expired session. The scheme is checked because the URL comes from a
      // third-party API and ends up in window.open().
      //
      // `noopener` as a window feature makes open() return null even when it succeeded, and
      // this needs the handle to tell "blocked" apart from "opened" — so the reference is
      // severed by hand instead, which prevents reverse tabnabbing just the same.
      const win = /^https?:\/\//i.test(o.url) ? window.open('about:blank', '_blank') : null;
      if (win) { try { win.opener = null; } catch (_) {} }

      // A blocked pop-up cannot complete the step, so say so instead of leaving the row spinning
      // against a tab that never opened.
      if (!win) {
        showError('Your browser blocked the offer tab. Allow pop-ups for this site, then tap the step again.');
        return;
      }

      const d = await api('offer_open', { flow_token: state.token, i: n });
      if (!d || !d.success) {
        try { win.close(); } catch (_) {}
        if (d && d.restart) return restart(d.message);
        showError((d && d.message) || 'Could not open the offer. Please try again.');
        return;
      }
      applyState(d);
      try { win.location.href = o.url; } catch (_) {
        showError('Could not open the offer. Please try again.');
      }
    }

    // One ticker drives the page. An open step is polled — the answer lives on the server,
    // written by the tab Bstlar redirected back — and it keeps polling while this tab is in
    // the background, because that is exactly where it is while the user is on the offer.
    let pollingStep = 0;
    let beatsSinceSync = 0;
    let pollBeats = POLL_EVERY;
    const BEAT_EVERY = 10;   // one heartbeat every ten seconds of screen time
    async function tick() {
      if (state.banned) return;
      for (let i = 0; i < state.progress.length; i++) {
        const p = state.progress[i];
        if (!p || !p.opened || p.done) continue;
        if (++pollBeats >= POLL_EVERY && pollingStep !== i + 1) {
          pollBeats = 0;
          pollingStep = i + 1;
          const d = await api('offer_done', { flow_token: state.token, i: i + 1 });
          pollingStep = 0;
          if (d && d.restart) return restart(d.message);
          if (d) applyState(d);
        }
      }

      // The waitlist: it starts by itself once the last step verifies, and from then on it
      // only moves while the page is active. The countdown on screen is a local copy that
      // the heartbeat re-syncs to whatever the server has actually credited.
      if (state.allDone && !state.keyDone && pageIsActive() && !state.busy) {
        if (state.waitStarted && state.waitLeft > 0) state.waitLeft -= 1;

        const needBeat = !state.waitStarted                       // first beat starts it
          || ++beatsSinceSync >= BEAT_EVERY                       // routine re-sync
          || (state.waitLeft <= 0 && !state.proof);               // finished: collect the proof

        if (needBeat) {
          beatsSinceSync = 0;
          state.busy = true;
          const d = await api('wait_tick', { flow_token: state.token });
          state.busy = false;
          if (d && d.restart) return restart(d.message);
          if (d) applyState(d);
        }
      }

      render();
      setTimeout(tick, 1000);
    }

    function restart(msg) {
      lsDel(FLOW_STORAGE);
      state.token = null;
      // The proof goes with the session it belonged to. Carrying it into the next run would
      // mean sending a proof the server never issued for that session — which the server
      // reads, correctly, as a script driving the funnel, and blocks for.
      state.proof = '';
      state.allDone = false;
      state.waitStarted = false;
      unlockSpin = null;
      gateShow('Session expired', msg || 'Please start again.', { retry: true, premium: true });
    }

    // ─── Plans ────────────────────────────────────────────────────────────────
    function planMarkup(p, i) {
      const price = p.price
        ? '<span class="text-right flex-shrink-0" data-price="' + i + '"><span class="plan-price">' + p.price + '</span><span class="plan-unit">' + esc(p.unit || '') + '</span></span>'
        : '<i class="fas fa-arrow-right text-[11px]" style="color:var(--muted)"></i>';
      const isSel = i === selectedPlan;
      return '<div class="plan-wrap' + (isSel ? ' is-selected' : '') + '">' +
               (p.badge ? '<span class="badge-most">' + esc(p.badge) + '</span>' : '') +
               '<button type="button" class="plan' + (isSel ? ' selected' : '') + '" data-plan="' + i + '">' +
               '<span class="min-w-0 flex-1">' +
                 '<span class="flex items-center gap-2">' +
                   '<span class="text-[13.5px] font-black">' + esc(p.name) + '</span>' +
                   (p.tag ? '<span class="text-[8px] font-black uppercase tracking-[0.12em] px-1.5 py-0.5 rounded" style="background:var(--green);color:#05230f">' + esc(p.tag) + '</span>' : '') +
                 '</span>' +
                 '<span class="block text-[10.5px] font-medium mt-0.5"' + (p.unit === '/weekly' ? ' data-weekly-sub' : p.unit === '/monthly' ? ' data-monthly-sub' : '') + ' style="color:var(--muted)">' + esc(p.sub) + '</span>' +
               '</span>' +
               price +
               '</button>' +
             '</div>';
    }

    // ── Localized price display (approximate) ──────────────────────────────────
    // The card shows an APPROXIMATE price in the visitor's currency; the exact charge is set
    // by Stripe Adaptive Pricing at checkout, so a small difference is expected (the "≈"
    // signals that). Country comes from Cloudflare's same-origin trace — no key, not blockable,
    // no mixed-content problem the way a client-side ip-api call would have. The FX rate is a
    // free no-key lookup cached for a day. Any failure silently leaves the base price shown.
    // ponytail: set BASE_CURRENCY to 'BRL' (and the plan `amount`s to your BRL prices) the
    // moment the SellAuth product is priced in BRL, so the card matches the localized checkout.
    const BASE_CURRENCY = 'BRL';
    const COUNTRY_CCY = {
      US:'USD', BR:'BRL', GB:'GBP', CA:'CAD', AU:'AUD', NZ:'NZD', JP:'JPY', CN:'CNY', IN:'INR',
      ID:'IDR', PH:'PHP', TH:'THB', VN:'VND', MY:'MYR', SG:'SGD', KR:'KRW', HK:'HKD', TW:'TWD',
      TR:'TRY', RU:'RUB', UA:'UAH', ZA:'ZAR', NG:'NGN', EG:'EGP', KE:'KES', MA:'MAD', SA:'SAR',
      AE:'AED', IL:'ILS', QA:'QAR', KW:'KWD', MX:'MXN', AR:'ARS', CL:'CLP', CO:'COP', PE:'PEN',
      UY:'UYU', CH:'CHF', NO:'NOK', SE:'SEK', DK:'DKK', PL:'PLN', CZ:'CZK', HU:'HUF', RO:'RON',
      BG:'BGN', IS:'ISK',
      AT:'EUR', BE:'EUR', CY:'EUR', EE:'EUR', FI:'EUR', FR:'EUR', DE:'EUR', GR:'EUR', IE:'EUR',
      IT:'EUR', LV:'EUR', LT:'EUR', LU:'EUR', MT:'EUR', NL:'EUR', PT:'EUR', SK:'EUR', SI:'EUR',
      ES:'EUR', HR:'EUR'
    };

    let priceFmt = null, priceRate = 1;   // set once localization is ready
    function applyLocalizedPrices() {
      if (!priceFmt) return;
      document.querySelectorAll('[data-price]').forEach(function (cell) {
        const i = parseInt(cell.getAttribute('data-price'), 10);
        const p = PLANS[i];
        if (!p || typeof p.amount !== 'number') return;
        cell.innerHTML = '<span class="plan-price plan-price-loc">≈ ' + esc(priceFmt.format(p.amount * priceRate)) + '</span>' +
                         '<span class="plan-unit">' + esc(p.unit || '') + '</span>';
      });
      const weeklySub = document.querySelector('[data-weekly-sub]');
      if (weeklySub && PLANS[0] && typeof PLANS[0].amount === 'number') {
        weeklySub.textContent = '7 days · about ' + priceFmt.format(PLANS[0].amount * priceRate / 7) + ' daily';
      }
      const monthlySub = document.querySelector('[data-monthly-sub]');
      if (monthlySub && PLANS[1] && typeof PLANS[1].amount === 'number') {
        monthlySub.textContent = '30 days · about ' + priceFmt.format(PLANS[1].amount * priceRate / (30.4375 / 7)) + ' a week';
      }
    }

    (async function setupLocalizedPrices() {
      let cc = '';
      try {
        const t = await fetch('/cdn-cgi/trace', { cache: 'no-store' }).then(function (r) { return r.text(); });
        cc = (t.match(/loc=([A-Z]{2})/) || [])[1] || '';
      } catch (_) {}
      const ccy = COUNTRY_CCY[cc] || '';
      if (!ccy || ccy === BASE_CURRENCY) return;

      let rates = null;
      try {
        const key = 'kali_fx_' + BASE_CURRENCY;
        let cached = null;
        try { cached = JSON.parse(localStorage.getItem(key) || 'null'); } catch (_) {}
        if (cached && (Date.now() - cached.t) < 86400000 && cached.r) rates = cached.r;
        if (!rates) {
          const j = await fetch('https://open.er-api.com/v6/latest/' + BASE_CURRENCY, { cache: 'no-store' }).then(function (r) { return r.json(); });
          if (j && j.result === 'success' && j.rates) {
            rates = j.rates;
            try { localStorage.setItem(key, JSON.stringify({ t: Date.now(), r: rates })); } catch (_) {}
          }
        }
      } catch (_) {}
      if (!rates || !rates[ccy]) return;

      try { priceFmt = new Intl.NumberFormat(undefined, { style: 'currency', currency: ccy }); }
      catch (_) { return; }
      priceRate = rates[ccy];
      applyLocalizedPrices();
    })();

    function renderPlans() {
      document.getElementById('plans').innerHTML = PLANS.map(planMarkup).join('');
      syncPayButtons();
      applyLocalizedPrices();
    }

    // Every payment button checks out the plan that is currently selected.
    function syncPayButtons() {
      const url = PLANS[selectedPlan].url;
      ['pay-card', 'pay-apple', 'pay-link', 'pay-google'].forEach(function (id) {
        const el = document.getElementById(id);
        if (el) el.href = url;
      });
    }

    // A plan card picks what the payment buttons below it will check out.
    document.addEventListener('click', function (e) {
      const card = e.target.closest('[data-plan]');
      if (!card) return;
      const i = parseInt(card.getAttribute('data-plan'), 10);
      if (isNaN(i)) return;
      selectedPlan = i;
      renderPlans();
    });

    // SpotlightCard: feed the pointer position to CSS instead of animating in JS, so the
    // paint stays on the compositor.
    document.addEventListener('pointermove', function (e) {
      const card = e.target.closest('.plan');
      if (!card) return;
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      card.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });

    // ─── Proceed ──────────────────────────────────────────────────────────────
    // The first click sends them to the Premium page in a new tab; coming back and pressing
    // Proceed again continues to the key.
    async function onProceed() {
      if (!state.proof || state.busy) return;

      // Once, before the key: the Premium pitch opens in its own tab. Coming back and
      // pressing Proceed again continues the funnel.
      if (!state.planShown) {
        state.planShown = true;
        saveFlowState();
        location.href = 'kalipremium?from=keysystem';
        return;
      }

      const btn = document.getElementById('proceed-btn');
      const label = document.getElementById('proceed-label');
      state.busy = true;
      btn.disabled = true;
      btn.querySelector('i').className = 'fas fa-circle-notch fa-spin text-[10px]';
      label.innerText = 'Generating…';

      // A second, fresh Turnstile — the one at init was solved five minutes ago and a key farm
      // amortises that across a pool of parked sessions. This one is spent at the instant a key
      // is actually minted, so it cannot be prepared in advance. Usually invisible; the gate is
      // only on screen long enough for the widget to answer.
      gateShow('Almost there', 'One last verification before your key…', { captcha: true });
      const cfTok = await getCaptchaToken();
      gateHide();

      const d = await api('verify', { flow_token: state.token, verify_proof: state.proof, cf_token: cfTok });

      state.busy = false;
      if (!d || !d.success) {
        btn.disabled = false;
        btn.querySelector('i').className = 'fas fa-lock-open text-[10px]';
        label.innerText = 'Unlock key';
        if (d && d.restart) return restart(d.message);
        showError((d && d.message) || 'Could not generate your key. Please try again.');
        return;
      }

      // The server's expiry is authoritative — the key stays valid exactly as long as
      // Luarmor says, not as long as this tab thinks.
      const expireAt = d.expire_at * 1000;
      saveKey(d.user_key, expireAt);
      showKey(d.user_key, expireAt);
      lsDel(FLOW_STORAGE);
      loadPopunder();
    }

    // ─── Key ──────────────────────────────────────────────────────────────────
    // The key outlives the page: it is stored with the server's own expiry, survives a
    // refresh, a closed tab and a new tab, and when it finally expires the whole funnel
    // comes back from step 1.

    // Returns the stored key only while it is genuinely usable. Anything else — malformed,
    // expired, unreadable — is deleted along with the funnel session, so the next boot
    // starts a clean run instead of resuming a session whose key is already gone.
    function getStoredKey() {
      try {
        const raw = lsGet(KEY_STORAGE);
        if (!raw) return null;
        const o = JSON.parse(raw);
        if (!o || typeof o.key !== 'string' || typeof o.expireAt !== 'number' ||
            isNaN(o.expireAt) || o.expireAt < 1577836800000) {    // 2020-01-01: junk
          lsDel(KEY_STORAGE);
          return null;
        }
        if (Date.now() >= o.expireAt) {
          lsDel(KEY_STORAGE);                                      // expired while away
          return null;
        }
        return o;
      } catch (_) {
        lsDel(KEY_STORAGE);
        return null;
      }
    }

    function saveKey(key, expireAtMs) {
      // lsSet never throws: the key must reach the screen even when storage is unavailable,
      // because the server has already burned the session and cannot reissue it.
      lsSet(KEY_STORAGE, JSON.stringify({ key: key, expireAt: expireAtMs }));
    }

    let keyTimer = null;
    let keyWatch = null;
    let keyWatchBound = false;

    // Keep asking Luarmor whether this key is still alive: every five minutes, and the
    // moment the tab comes back to the front. A verdict of "not active" restarts the funnel
    // immediately instead of waiting for the local countdown to run out. Anything the server
    // could not determine (Luarmor down, rate limited) leaves the key alone — active comes
    // back as null there, and only an explicit false takes a key away.
    function watchKeyLife(key) {
      clearInterval(keyWatch);

      const check = async function () {
        if (document.hidden) return;
        const live = await api('key_check', { user_key: key });
        if (!live) return;
        if (live.active === false) return expireNow();
        if (live.expire_at) {
          const ms = live.expire_at * 1000;
          saveKey(key, ms);
          if (keyExpireAt !== ms) { keyExpireAt = ms; }
        }
      };

      keyWatch = setInterval(check, 300000);
      if (!keyWatchBound) {
        keyWatchBound = true;
        document.addEventListener('visibilitychange', function () { if (!document.hidden) check(); });
      }
    }

    let keyExpireAt = 0;
    function showKey(key, expireAtMs) {
      state.keyDone = true;
      // No popunder here: the key screen is where the user reads their key and where the
      // Premium CTA sits, so an interruption would only cost us the upsell.

      // The funnel has nothing left to do while this key lives.
      document.getElementById('funnel').classList.add('hidden');


      const card = document.getElementById('key-card');
      card.classList.remove('hidden');
      // With the funnel gone the key is the whole point of the page, so it moves up to the
      // top instead of sitting below the Premium block.
      const slot = document.getElementById('key-slot');
      if (slot && slot.parentNode) slot.parentNode.insertBefore(card, slot);

      // Nothing is being chosen between any more, so the OR rule goes with the funnel.
      const rule = document.getElementById('or-divider');
      if (rule) rule.classList.add('hidden');

      // The pitch changes once they hold a key: there is nothing left to skip today, but
      // this key expires and the steps come back tomorrow.
      const pitch = document.getElementById('premium-pitch');
      if (pitch) {
        pitch.classList.add('mt-5');   // the OR rule that used to sit above it is gone
        pitch.innerHTML =
          '<p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[13px] font-medium">' +
            '<span>This key expires in 24 hours and the steps start over. A premium key does not.</span>' +
          '</p>' +
          '<p class="mt-1.5 flex flex-wrap items-center justify-center gap-x-2 text-[11.5px]" style="color:var(--muted)">' +
            '<img src="public/Kali Hub Logo.png" alt="" class="w-[16px] h-[16px] object-contain">' +
            '<span class="shiny font-semibold">Kali Premium</span>' +
            '<span>— your own key, for the whole plan.</span>' +
          '</p>';
      }
      document.getElementById('key-display').innerText = key;

      keyExpireAt = expireAtMs;
      watchKeyLife(key);

      clearInterval(keyTimer);
      const paint = function () {
        const left = keyExpireAt - Date.now();
        if (left <= 0) {
          clearInterval(keyTimer);
          expireNow();
          return;
        }
        const h = Math.floor(left / 3600000);
        const m = Math.floor(left / 60000) % 60;
        const s = Math.floor(left / 1000) % 60;
        document.getElementById('key-left').innerText = h + 'h ' + m + 'm ' + s + 's';
      };
      paint();
      keyTimer = setInterval(paint, 1000);
    }

    // Key expired with the page open: drop it, drop the session, and put the user back at
    // step 1. A reload is the honest reset — it re-runs the captcha and mints a fresh
    // session exactly like a first visit, with no half-restored state left behind.
    function expireNow() {
      lsDel(KEY_STORAGE);
      window.location.reload();
    }

    function copyKey() {
      const key = document.getElementById('key-display').innerText;
      if (!key || key === '—') return;
      navigator.clipboard.writeText(key).catch(function () {
        const t = document.createElement('textarea');
        t.value = key; document.body.appendChild(t); t.select();
        try { document.execCommand('copy'); } catch (_) {}
        t.remove();
      });
      const st = document.getElementById('key-status');
      st.innerText = 'Copied';
      setTimeout(function () { st.innerText = 'Active'; }, 1500);
    }

    boot();
  </script>
</body>
</html>
