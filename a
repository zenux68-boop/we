<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="/" />
  <link rel="icon" href="public/Kali Hub Logo.png" type="image/png" />
  <title>Key System - Kali Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Geist for the interface, Geist Mono for anything the eye has to read character by
       character: the key itself and the two countdowns. One family, two roles. -->
  
  <style type="text/css">@font-face {font-family:'Geist';font-style:normal;font-weight:300 800;src:url(/cf-fonts/v/geist/5.2.8/cyrillic/wght/normal.woff2);unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;font-display:swap;}@font-face {font-family:'Geist';font-style:normal;font-weight:300 800;src:url(/cf-fonts/v/geist/5.2.8/latin/wght/normal.woff2);unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;font-display:swap;}@font-face {font-family:'Geist';font-style:normal;font-weight:300 800;src:url(/cf-fonts/v/geist/5.2.8/latin-ext/wght/normal.woff2);unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;font-display:swap;}@font-face {font-family:'Geist Mono';font-style:normal;font-weight:400 600;src:url(/cf-fonts/v/geist-mono/5.2.7/latin-ext/wght/normal.woff2);unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;font-display:swap;}@font-face {font-family:'Geist Mono';font-style:normal;font-weight:400 600;src:url(/cf-fonts/v/geist-mono/5.2.7/latin/wght/normal.woff2);unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;font-display:swap;}@font-face {font-family:'Geist Mono';font-style:normal;font-weight:400 600;src:url(/cf-fonts/v/geist-mono/5.2.7/cyrillic/wght/normal.woff2);unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;font-display:swap;}</style>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=cfReady" async defer></script>
  <script>
    // api.js calls this once it is ready; the main script polls window.turnstile anyway, so
    // this only records that the script arrived (it never renders into a hidden container).
    window.cfReady = function () { window.__cfLoaded = true; };
  </script>
  <style>
    /* ── Palette ───────────────────────────────────────────────────────────── */
    :root {
      --bg:        #0b0b0d;
      --row:       #151619;
      --row-hover: #1a1b1f;
      --num:       #101114;
      --line:      #232429;
      --text:      #f3f4f6;
      --muted:     #83868f;
      --steel:     #7ea8d6;   /* the instruction line + the step in progress */
      --green:     #3ecf8e;   /* completed steps + ticks */
      --red:       #ff3b30;   /* the waitlist countdown */
      --blue:      #4c8bf5;   /* Pay with Card */
      --link:      #00d66f;   /* Link checkout */
      --radius:    12px;
    }

    html, body { background: var(--bg); color: var(--text); overflow-x: hidden; }
    /* iOS Safari's 100vh counts the browser chrome, so the layout overflows the visible
       area. dvh tracks the real viewport; the @supports guard keeps older engines on vh. */
    @supports (min-height: 100dvh) { body { min-height: 100dvh; } }
    body {
      font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
      letter-spacing: -0.005em;
      -webkit-font-smoothing: antialiased;
    }
    /* Timers and the key are read one character at a time, and digits that change width
       make a countdown twitch. */
    .mono, .tabular { font-variant-numeric: tabular-nums; }
    .mono { font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }

    /* Ambient light behind the card — the page's only decoration, kept below 8% so the
       rows stay the thing you look at. */
    .ambient {
      position: fixed; inset: 0; pointer-events: none; z-index: -1;
      background:
        radial-gradient(760px 420px at 50% -8%, rgba(126,168,214,.10), transparent 70%),
        radial-gradient(520px 360px at 50% 108%, rgba(0,214,111,.05), transparent 72%);
    }

    :focus-visible { outline: 2px solid var(--steel); outline-offset: 2px; border-radius: 8px; }

    /* ── FadeContent (React Bits) ───────────────────────────────────────────
       The library is React-only and this page has no build step, so the four
       effects it contributes are rebuilt in plain CSS: FadeContent here,
       ShinyText / StarBorder / SpotlightCard further down. */
    @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    .fade { animation: fadeUp .45s cubic-bezier(.16,1,.3,1) both; }
    .fade-1 { animation-delay: .04s } .fade-2 { animation-delay: .10s }
    .fade-3 { animation-delay: .16s } .fade-4 { animation-delay: .22s }

    /* ── Step rows ─────────────────────────────────────────────────────────────
       The numbered rail is the page's signature: the number, the task and its state each
       get their own cell, so a glance down the left edge tells you how far along you are
       and a glance down the right edge tells you what is still running. */
    .step {
      display: flex; align-items: stretch; width: 100%; text-align: left;
      background: var(--row); border: 1px solid var(--line); border-radius: var(--radius);
      overflow: hidden; transition: background-color .18s ease, border-color .18s ease, transform .1s ease;
    }
    .step:not(.is-done):not(.is-locked):hover { background: var(--row-hover); border-color: #33343a; }
    .step:not(.is-done):not(.is-locked):active { transform: scale(.995); }
    .step.is-locked { opacity: .5; cursor: default; }
    .step-num {
      flex: 0 0 42px; display: flex; align-items: center; justify-content: center;
      background: var(--num); border-right: 1px solid var(--line);
      font-size: 12px; font-weight: 600; color: #5a5c66;
      font-variant-numeric: tabular-nums;
    }
    .step-body { flex: 1 1 auto; min-width: 0; padding: 13px 15px; }
    .step-title { display: block; font-size: 13.5px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
    .step-desc  { display: block; font-size: 11.5px; color: var(--muted); margin-top: 4px; line-height: 1.45; font-weight: 400; }
    .step-state {
      flex: 0 0 48px; display: flex; align-items: center; justify-content: center;
      background: var(--num); border-left: 1px solid var(--line); color: #4a4c55; font-size: 13px;
    }
    .step.is-done .step-title { color: var(--green); }
    .step.is-done .step-state { color: var(--green); }

    /* A step being verified: the state cell is the only thing that moves on the page, so
       it gets a soft ring instead of shouting. */
    .step.is-active .step-state { color: var(--steel); background: rgba(126,168,214,.07); }
    .step.is-active { border-color: rgba(126,168,214,.25); }

    /* ── Waitlist strip ────────────────────────────────────────────────────── */
    .waitpill {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      background: var(--row); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 11px 16px; font-size: 12px; font-weight: 500; color: var(--muted);
    }
    .waitpill .count { color: var(--red); font-weight: 600; font-variant-numeric: tabular-nums; }
    /* Windows falls back to a monochrome glyph without an explicit emoji face. */
    .waitpill .emoji { font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif; }
    .btn-proceed {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      border-radius: var(--radius); padding: 11px 18px; font-size: 12.5px; font-weight: 600;
      background: #17181b; border: 1px solid var(--line); color: #5b5d66;
      transition: background-color .2s ease, color .2s ease, border-color .2s ease;
      cursor: not-allowed;
    }
    .btn-proceed.ready {
      background: var(--green); border-color: var(--green); color: #04240f; cursor: pointer;
      box-shadow: 0 0 0 4px rgba(62,207,142,.10);
    }
    .btn-proceed.ready:hover { filter: brightness(1.06); }

    /* ── OR divider ────────────────────────────────────────────────────────── */
    .divider { display: flex; align-items: center; gap: 12px; color: #4a4c55; font-size: 9.5px; font-weight: 600; letter-spacing: .24em; }
    .divider::before, .divider::after {
      content: ''; flex: 1; height: 1px;
      background: repeating-linear-gradient(90deg, #2a2b31 0 5px, transparent 5px 10px);
    }

    /* ── ShinyText (React Bits) ────────────────────────────────────────────── */
    .shiny {
      background: linear-gradient(110deg, #ffffff 38%, #b8b8c4 46%, #ffffff 54%);
      background-size: 220% 100%;
      -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: shinyText 5.5s linear infinite;
    }
    @keyframes shinyText { from { background-position: 200% 0; } to { background-position: -80% 0; } }

    /* ── Plan cards ────────────────────────────────────────────────────────── */
    .plan {
      position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px;
      width: 100%; text-align: left; padding: 16px; border-radius: var(--radius);
      background: var(--row); border: 1px solid var(--line); overflow: hidden;
      transition: border-color .2s ease, background-color .2s ease, transform .1s ease;
    }
    .plan:hover { border-color: #33343a; }
    .plan:active { transform: scale(.995); }
    .plan.selected { border-color: #ffffff; background: #191a1e; }   /* fallback if the frame above is disabled */

    /* SpotlightCard (React Bits): --mx/--my are written by the pointermove handler. */
    .plan::after {
      content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
      opacity: 0; transition: opacity .28s ease;
      background: radial-gradient(200px circle at var(--mx,50%) var(--my,50%), rgba(255,255,255,.07), transparent 62%);
    }
    .plan:hover::after { opacity: 1; }

    /* StarBorder (React Bits): a 1px gradient frame that travels around the chosen plan.
       It lives on the wrapper as padding, with the card painted opaquely on top — the
       background-clip version of this trick leaks the gradient into the card body. */
    .plan-wrap.is-selected {
      padding: 1px; border-radius: calc(var(--radius) + 1px);
      background: linear-gradient(90deg, rgba(255,255,255,.16) 0%, #ffffff 25%, rgba(255,255,255,.16) 50%, #ffffff 75%, rgba(255,255,255,.16) 100%);
      background-size: 200% 100%;
      animation: starBorder 5s linear infinite;
    }
    .plan-wrap.is-selected .plan { border-color: transparent; background: #191a1e; }
    @keyframes starBorder { from { background-position: 0 0; } to { background-position: 200% 0; } }

    /* The badge straddles the card's top edge, so it lives on a wrapper — the card itself
       clips its own spotlight overlay with overflow:hidden. */
    .plan-wrap { position: relative; }
    .badge-most {
      position: absolute; top: 0; left: 14px; transform: translateY(-50%);
      background: #26272c; color: #c9cbd3; border: 1px solid #34363c;
      font-size: 8px; font-weight: 600; letter-spacing: .16em;
      padding: 3px 7px; border-radius: 5px; z-index: 1;
    }
    .plan-price { font-size: 25px; font-weight: 600; line-height: 1; letter-spacing: -.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .plan-price-loc { font-size: 17px; letter-spacing: -.01em; }
    .plan-price sup { font-size: 12px; font-weight: 600; vertical-align: super; }
    .plan-unit { display: block; font-size: 10px; color: var(--muted); font-weight: 500; margin-top: 5px; text-align: right; }

    /* ── Payment buttons ───────────────────────────────────────────────────── */
    .pay {
      display: flex; align-items: center; justify-content: center; gap: 9px;
      width: 100%; min-height: 48px; border-radius: var(--radius); padding: 13px 16px;
      touch-action: manipulation;
      font-size: 13.5px; font-weight: 600; white-space: nowrap;
      transition: filter .18s ease, transform .1s ease;
    }
    .pay:hover { filter: brightness(1.07); }
    .pay:active { transform: scale(.995); }
    .pay-card  { background: var(--blue); color: #fff; position: relative; overflow: hidden; }
    .pay-apple { background: #fff; color: #000; }
    .pay-link  { background: #fff; color: #000; }
    .pay-google { background: #fff; color: #3c4043; }
    .brand-link { display: block; width: 51px; height: 17px; }
    .brand-google-pay { display: block; width: auto; height: 36px; }
    /* ShinyText's sweep, applied to the primary CTA. The long pause is the point: a sweep
       on a short loop reads as a loading bar, not as premium. */
    .pay-card::after {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,.45) 50%, transparent 62%);
      transform: translateX(-130%); animation: sweep 5s ease-in-out infinite;
    }
    @keyframes sweep { 0%, 74% { transform: translateX(-130%); } 100% { transform: translateX(130%); } }
    .brand { display: block; height: 17px; width: auto; border-radius: 3px; }
    /* Premium pill — the one always-visible way out of the funnel. Sits in the header so
       it is on screen before the user has scrolled to the plans. */
    .premium-pill {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 6px 6px 6px 11px; border-radius: 999px;
      background: #101114; border: 1px solid var(--line);
      font-size: 12px; font-weight: 500; color: var(--text);
      transition: border-color .2s ease, background-color .2s ease, transform .1s ease;
    }
    .premium-pill:hover { border-color: #3a3c44; background: #16171b; }
    .premium-pill:active { transform: scale(.98); }
    .premium-off {
      background: var(--blue); color: #fff; border-radius: 999px;
      font-size: 9.5px; font-weight: 600; letter-spacing: .02em; padding: 4px 8px;
    }

    .tick { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #9b9ea7; font-weight: 500; }
    .tick i { color: var(--green); font-size: 9px; }

    @media (prefers-reduced-motion: reduce) {
      .fade, .shiny, .plan-wrap.is-selected, .pay-card::after { animation: none; }
      .shiny { color: #fff; -webkit-background-clip: initial; background-clip: initial; background: none; }
    }

    /* Ad-blocker bait: the class names every filter list hides on sight. If this element
       ends up with no box, something is filtering the page. */
    #ad-banner-bait { width: 300px; height: 90px; position: absolute; left: -9999px; top: -9999px; }
  </style>
</head>
<body class="antialiased min-h-screen flex items-start md:items-center justify-center px-4 py-7 sm:py-10">

  <div class="ambient"></div>

  <!-- Anti-devtools curtain. Hidden by default; shown while developer tools appear open. -->
  <div id="devtools-wall" class="fixed inset-0 z-[400] hidden items-center justify-center p-6" style="background:var(--bg);">
    <div class="w-full max-w-sm text-center rounded-2xl p-8" style="background:var(--row);border:1px solid var(--line);">
      <img src="public/Kali Hub Logo.png" alt="Kali Hub" class="w-10 h-10 object-contain mx-auto mb-5">
      <h2 class="text-[17px] font-semibold tracking-tight">Developer tools detected</h2>
      <p class="text-[12.5px] mt-2" style="color:var(--muted)">Close developer tools to continue. The key system does not run while they are open.</p>
    </div>
  </div>

  <!-- ── Gate: browser check, then captcha ─────────────────────────────────── -->
  <div id="gate" class="fixed inset-0 z-[300] flex items-center justify-center p-4" style="background:var(--bg);">
    <div class="w-full max-w-sm text-center rounded-2xl p-8" style="background:var(--row);border:1px solid var(--line);">
      <img src="public/Kali Hub Logo.png" alt="Kali Hub" class="w-10 h-10 object-contain mx-auto mb-5">
      <h2 class="text-[17px] font-semibold tracking-tight" id="gate-title">Kali Hub</h2>
      <p class="text-[12.5px] mt-2 mb-6" style="color:var(--muted)" id="gate-msg">Checking your browser…</p>

      <div id="gate-turnstile" class="hidden justify-center"></div>
      <div id="gate-spinner" class="flex justify-center py-1"><i class="fas fa-circle-notch fa-spin text-xl" style="color:var(--muted)"></i></div>

      <button id="gate-retry" onclick="boot()" class="hidden w-full mt-5 py-3 rounded-xl font-semibold text-[13px]" style="background:var(--green);color:#04240f;">
        Try again
      </button>
      <a id="gate-premium" href="kalipremium" class="hidden mt-3 text-[10.5px] font-semibold uppercase tracking-[0.15em]" style="color:var(--muted)">Get Kali Premium instead</a>
    </div>
  </div>

  <!-- ── Main ──────────────────────────────────────────────────────────────── -->
  <main id="app" class="w-full max-w-[470px] hidden">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-5 sm:mb-6 fade fade-1">
      <img src="public/Kali Hub Logo.png" alt="Kali Hub" class="w-[26px] h-[26px] object-contain flex-shrink-0">
      <h1 class="text-[16px] sm:text-[18px] font-semibold tracking-[-0.02em] truncate min-w-0 flex-1">Kali Hub — Key System</h1>
      <a href="kalipremium" class="premium-pill flex-shrink-0">
        <img src="public/Kali Hub Logo.png" alt="" class="w-[14px] h-[14px] object-contain">
        <span>Premium</span>
        <span class="premium-off">70% OFF</span>
      </a>
    </div>

    <!-- The whole funnel. Hidden while a key from a previous run is still valid — that key
         is the thing the funnel exists to produce, so there is nothing to do until it
         expires (see showKey / getStoredKey). -->
    <div id="funnel">
      <p class="text-[12.5px] font-medium mb-3.5 fade fade-2" style="color:var(--steel)">
        To get your key, complete the following steps:
      </p>

      <!-- Steps -->
      <div id="steps" class="space-y-2 fade fade-2"></div>

      <!-- Waitlist + Proceed: hidden until every offer is verified -->
      <div id="waitbar" class="hidden mt-4 flex flex-col min-[420px]:flex-row items-stretch justify-center gap-2">
        <div id="waitpill" class="waitpill flex-1"><span id="wait-text"></span></div>
        <button id="proceed-btn" class="btn-proceed min-[420px]:w-[168px]" disabled onclick="onProceed()">
          <i class="fas fa-lock text-[10px]"></i> <span id="proceed-label">Unlock key</span>
        </button>
      </div>

      <p id="flow-error" class="hidden text-[11px] font-bold mt-3 text-center" style="color:var(--red)"></p>
    </div>

    <!-- Anchor the key card moves to once a key exists (see showKey) -->
    <div id="key-slot"></div>

    <!-- OR -->
    <div id="or-divider" class="divider my-6 fade fade-3">OR</div>

    <!-- ── Kali Premium ────────────────────────────────────────────────────── -->
    <section class="fade fade-3">
      <div id="premium-pitch" class="text-center mb-5">
        <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[13px] font-medium">
          <span>Or never come back here</span>
          <img src="public/Kali Hub Logo.png" alt="" class="w-[18px] h-[18px] object-contain">
          <span class="shiny font-semibold">Kali Premium</span>
        </p>
        <p class="mt-1.5 text-[11.5px]" style="color:var(--muted)">
          Your own key, delivered at checkout — no key system at all.
        </p>
      </div>

      <!-- Plans -->
      <div id="plans" class="space-y-2.5 pt-2"></div>

      <!-- Benefits -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5">
        <span class="tick"><i class="fas fa-check"></i> No key system, ever</span>
        <span class="tick"><i class="fas fa-check"></i> Key lasts the whole plan</span>
        <span class="tick"><i class="fas fa-check"></i> Priority support and updates</span>
        <span class="tick"><i class="fas fa-check"></i> Works on every supported game</span>
        <span class="tick"><i class="fas fa-check"></i> No data shared</span>
      </div>

      <p class="mt-4 text-center text-[10.5px] font-medium leading-relaxed" style="color:var(--muted)">
        <i class="far fa-envelope mr-1"></i>
        Your key is delivered instantly — to your purchase email.
      </p>

      <!-- Payment -->
      <div class="mt-4 space-y-2 fade fade-4">
        <a id="pay-card" href="#" class="pay pay-card">
          <span>Pay with Card</span>
          <!-- Brand marks drawn inline: the icon-font versions render as flat monochrome
               glyphs, and a hosted image is exactly the kind of request an ad blocker eats. -->
          <span class="flex items-center gap-1.5 ml-1">
            <svg class="brand" viewBox="0 0 28 18" role="img" aria-label="Mastercard">
              <rect width="28" height="18" rx="3" fill="#fff"/>
              <circle cx="11.2" cy="9" r="5.4" fill="#EB001B"/>
              <circle cx="16.8" cy="9" r="5.4" fill="#F79E1B"/>
              <path d="M14 4.9a5.4 5.4 0 0 0 0 8.2 5.4 5.4 0 0 0 0-8.2Z" fill="#FF5F00"/>
            </svg>
            <svg class="brand" viewBox="0 0 28 18" role="img" aria-label="American Express">
              <rect width="28" height="18" rx="3" fill="#1F72CF"/>
              <text x="14" y="12.1" text-anchor="middle" font-family="Geist, Arial, sans-serif" font-size="6.6" font-weight="700" letter-spacing="0.3" fill="#fff">AMEX</text>
            </svg>
