{"type": "response", "requestId": "C91AA1460B7FFD25AEB0A8AF0012D95B", "status": 200, "url": "https://kalihub.xyz/keysystem", "headers": {"alt-svc": "h3=\":443\"; ma=86400", "content-encoding": "br", "content-security-policy": "upgrade-insecure-requests", "content-type": "text/html; charset=utf-8", "date": "Sat, 05 Sep 2026 04:47:22 GMT", "panel": "hpanel", "platform": "hostinger", "server": "hcdn", "x-hcdn-cache-status": "DYNAMIC", "x-hcdn-request-id": "dc21fbdc5d51f5cbc8ceb2993ef9218d-mum-edge8", "x-hcdn-upstream-rt": "0.253", "x-powered-by": "PHP/8.3.33"}, "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <base href=\"/\" />\n  <link rel=\"icon\" href=\"public/Kali Hub Logo.png\" type=\"image/png\" />\n  <title>Key System - Kali Hub</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Geist for the interface, Geist Mono for anything the eye has to read character by\n       character: the key itself and the two countdowns. One family, two roles. -->\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400..600&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\" />\n  <script src=\"https://challenges.cloudflare.com/turnstile/v0/api.js?onload=cfReady\" async defer></script>\n  <script>\n    // api.js calls this once it is ready; the main script polls window.turnstile anyway, so\n    // this only records that the script arrived (it never renders into a hidden container).\n    window.cfReady = function () { window.__cfLoaded = true; };\n  </script>\n  <style>\n    /* \u2500\u2500 Palette \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    :root {\n      --bg:        #0b0b0d;\n      --row:       #151619;\n      --row-hover: #1a1b1f;\n      --num:       #101114;\n      --line:      #232429;\n      --text:      #f3f4f6;\n      --muted:     #83868f;\n      --steel:     #7ea8d6;   /* the instruction line + the step in progress */\n      --green:     #3ecf8e;   /* completed steps + ticks */\n      --red:       #ff3b30;   /* the waitlist countdown */\n      --blue:      #4c8bf5;   /* Pay with Card */\n      --link:      #00d66f;   /* Link checkout */\n      --radius:    12px;\n    }\n\n    html, body { background: var(--bg); color: var(--text); overflow-x: hidden; }\n    /* iOS Safari's 100vh counts the browser chrome, so the layout overflows the visible\n       area. dvh tracks the real viewport; the @supports guard keeps older engines on vh. */\n    @supports (min-height: 100dvh) { body { min-height: 100dvh; } }\n    body {\n      font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;\n      letter-spacing: -0.005em;\n      -webkit-font-smoothing: antialiased;\n    }\n    /* Timers and the key are read one character at a time, and digits that change width\n       make a countdown twitch. */\n    .mono, .tabular { font-variant-numeric: tabular-nums; }\n    .mono { font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }\n\n    /* Ambient light behind the card \u2014 the page's only decoration, kept below 8% so the\n       rows stay the thing you look at. */\n    .ambient {\n      position: fixed; inset: 0; pointer-events: none; z-index: -1;\n      background:\n        radial-gradient(760px 420px at 50% -8%, rgba(126,168,214,.10), transparent 70%),\n        radial-gradient(520px 360px at 50% 108%, rgba(0,214,111,.05), transparent 72%);\n    }\n\n    :focus-visible { outline: 2px solid var(--steel); outline-offset: 2px; border-radius: 8px; }\n\n    /* \u2500\u2500 FadeContent (React Bits) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n       The library is React-only and this page has no build step, so the four\n       effects it contributes are rebuilt in plain CSS: FadeContent here,\n       ShinyText / StarBorder / SpotlightCard further down. */\n    @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }\n    .fade { animation: fadeUp .45s cubic-bezier(.16,1,.3,1) both; }\n    .fade-1 { animation-delay: .04s } .fade-2 { animation-delay: .10s }\n    .fade-3 { animation-delay: .16s } .fade-4 { animation-delay: .22s }\n\n    /* \u2500\u2500 Step rows \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n       The numbered rail is the page's signature: the number, the task and its state each\n       get their own cell, so a glance down the left edge tells you how far along you are\n       and a glance down the right edge tells you what is still running. */\n    .step {\n      display: flex; align-items: stretch; width: 100%; text-align: left;\n      background: var(--row); border: 1px solid var(--line); border-radius: var(--radius);\n      overflow: hidden; transition: background-color .18s ease, border-color .18s ease, transform .1s ease;\n    }\n    .step:not(.is-done):not(.is-locked):hover { background: var(--row-hover); border-color: #33343a; }\n    .step:not(.is-done):not(.is-locked):active { transform: scale(.995); }\n    .step.is-locked { opacity: .5; cursor: default; }\n    .step-num {\n      flex: 0 0 42px; display: flex; align-items: center; justify-content: center;\n      background: var(--num); border-right: 1px solid var(--line);\n      font-size: 12px; font-weight: 600; color: #5a5c66;\n      font-variant-numeric: tabular-nums;\n    }\n    .step-body { flex: 1 1 auto; min-width: 0; padding: 13px 15px; }\n    .step-title { display: block; font-size: 13.5px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }\n    .step-desc  { display: block; font-size: 11.5px; color: var(--muted); margin-top: 4px; line-height: 1.45; font-weight: 400; }\n    .step-state {\n      flex: 0 0 48px; display: flex; align-items: center; justify-content: center;\n      background: var(--num); border-left: 1px solid var(--line); color: #4a4c55; font-size: 13px;\n    }\n    .step.is-done .step-title { color: var(--green); }\n    .step.is-done .step-state { color: var(--green); }\n\n    /* A step being verified: the state cell is the only thing that moves on the page, so\n       it gets a soft ring instead of shouting. */\n    .step.is-active .step-state { color: var(--steel); background: rgba(126,168,214,.07); }\n    .step.is-active { border-color: rgba(126,168,214,.25); }\n\n    /* \u2500\u2500 Waitlist strip \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .waitpill {\n      display: flex; align-items: center; justify-content: center; gap: 7px;\n      background: var(--row); border: 1px solid var(--line); border-radius: var(--radius);\n      padding: 11px 16px; font-size: 12px; font-weight: 500; color: var(--muted);\n    }\n    .waitpill .count { color: var(--red); font-weight: 600; font-variant-numeric: tabular-nums; }\n    /* Windows falls back to a monochrome glyph without an explicit emoji face. */\n    .waitpill .emoji { font-family: \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Noto Color Emoji\", sans-serif; }\n    .btn-proceed {\n      display: flex; align-items: center; justify-content: center; gap: 7px;\n      border-radius: var(--radius); padding: 11px 18px; font-size: 12.5px; font-weight: 600;\n      background: #17181b; border: 1px solid var(--line); color: #5b5d66;\n      transition: background-color .2s ease, color .2s ease, border-color .2s ease;\n      cursor: not-allowed;\n    }\n    .btn-proceed.ready {\n      background: var(--green); border-color: var(--green); color: #04240f; cursor: pointer;\n      box-shadow: 0 0 0 4px rgba(62,207,142,.10);\n    }\n    .btn-proceed.ready:hover { filter: brightness(1.06); }\n\n    /* \u2500\u2500 OR divider \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .divider { display: flex; align-items: center; gap: 12px; color: #4a4c55; font-size: 9.5px; font-weight: 600; letter-spacing: .24em; }\n    .divider::before, .divider::after {\n      content: ''; flex: 1; height: 1px;\n      background: repeating-linear-gradient(90deg, #2a2b31 0 5px, transparent 5px 10px);\n    }\n\n    /* \u2500\u2500 ShinyText (React Bits) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .shiny {\n      background: linear-gradient(110deg, #ffffff 38%, #b8b8c4 46%, #ffffff 54%);\n      background-size: 220% 100%;\n      -webkit-background-clip: text; background-clip: text; color: transparent;\n      animation: shinyText 5.5s linear infinite;\n    }\n    @keyframes shinyText { from { background-position: 200% 0; } to { background-position: -80% 0; } }\n\n    /* \u2500\u2500 Plan cards \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .plan {\n      position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px;\n      width: 100%; text-align: left; padding: 16px; border-radius: var(--radius);\n      background: var(--row); border: 1px solid var(--line); overflow: hidden;\n      transition: border-color .2s ease, background-color .2s ease, transform .1s ease;\n    }\n    .plan:hover { border-color: #33343a; }\n    .plan:active { transform: scale(.995); }\n    .plan.selected { border-color: #ffffff; background: #191a1e; }   /* fallback if the frame above is disabled */\n\n    /* SpotlightCard (React Bits): --mx/--my are written by the pointermove handler. */\n    .plan::after {\n      content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;\n      opacity: 0; transition: opacity .28s ease;\n      background: radial-gradient(200px circle at var(--mx,50%) var(--my,50%), rgba(255,255,255,.07), transparent 62%);\n    }\n    .plan:hover::after { opacity: 1; }\n\n    /* StarBorder (React Bits): a 1px gradient frame that travels around the chosen plan.\n       It lives on the wrapper as padding, with the card painted opaquely on top \u2014 the\n       background-clip version of this trick leaks the gradient into the card body. */\n    .plan-wrap.is-selected {\n      padding: 1px; border-radius: calc(var(--radius) + 1px);\n      background: linear-gradient(90deg, rgba(255,255,255,.16) 0%, #ffffff 25%, rgba(255,255,255,.16) 50%, #ffffff 75%, rgba(255,255,255,.16) 100%);\n      background-size: 200% 100%;\n      animation: starBorder 5s linear infinite;\n    }\n    .plan-wrap.is-selected .plan { border-color: transparent; background: #191a1e; }\n    @keyframes starBorder { from { background-position: 0 0; } to { background-position: 200% 0; } }\n\n    /* The badge straddles the card's top edge, so it lives on a wrapper \u2014 the card itself\n       clips its own spotlight overlay with overflow:hidden. */\n    .plan-wrap { position: relative; }\n    .badge-most {\n      position: absolute; top: 0; left: 14px; transform: translateY(-50%);\n      background: #26272c; color: #c9cbd3; border: 1px solid #34363c;\n      font-size: 8px; font-weight: 600; letter-spacing: .16em;\n      padding: 3px 7px; border-radius: 5px; z-index: 1;\n    }\n    .plan-price { font-size: 25px; font-weight: 600; line-height: 1; letter-spacing: -.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }\n    .plan-price-loc { font-size: 17px; letter-spacing: -.01em; }\n    .plan-price sup { font-size: 12px; font-weight: 600; vertical-align: super; }\n    .plan-unit { display: block; font-size: 10px; color: var(--muted); font-weight: 500; margin-top: 5px; text-align: right; }\n\n    /* \u2500\u2500 Payment buttons \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .pay {\n      display: flex; align-items: center; justify-content: center; gap: 9px;\n      width: 100%; min-height: 48px; border-radius: var(--radius); padding: 13px 16px;\n      touch-action: manipulation;\n      font-size: 13.5px; font-weight: 600; white-space: nowrap;\n      transition: filter .18s ease, transform .1s ease;\n    }\n    .pay:hover { filter: brightness(1.07); }\n    .pay:active { transform: scale(.995); }\n    .pay-card  { background: var(--blue); color: #fff; position: relative; overflow: hidden; }\n    .pay-apple { background: #fff; color: #000; }\n    .pay-link  { background: #fff; color: #000; }\n    .pay-google { background: #fff; color: #3c4043; }\n    .brand-link { display: block; width: 51px; height: 17px; }\n    .brand-google-pay { display: block; width: auto; height: 36px; }\n    /* ShinyText's sweep, applied to the primary CTA. The long pause is the point: a sweep\n       on a short loop reads as a loading bar, not as premium. */\n    .pay-card::after {\n      content: ''; position: absolute; inset: 0; pointer-events: none;\n      background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,.45) 50%, transparent 62%);\n      transform: translateX(-130%); animation: sweep 5s ease-in-out infinite;\n    }\n    @keyframes sweep { 0%, 74% { transform: translateX(-130%); } 100% { transform: translateX(130%); } }\n    .brand { display: block; height: 17px; width: auto; border-radius: 3px; }\n    /* Premium pill \u2014 the one always-visible way out of the funnel. Sits in the header so\n       it is on screen before the user has scrolled to the plans. */\n    .premium-pill {\n      display: inline-flex; align-items: center; gap: 7px;\n      padding: 6px 6px 6px 11px; border-radius: 999px;\n      background: #101114; border: 1px solid var(--line);\n      font-size: 12px; font-weight: 500; color: var(--text);\n      transition: border-color .2s ease, background-color .2s ease, transform .1s ease;\n    }\n    .premium-pill:hover { border-color: #3a3c44; background: #16171b; }\n    .premium-pill:active { transform: scale(.98); }\n    .premium-off {\n      background: var(--blue); color: #fff; border-radius: 999px;\n      font-size: 9.5px; font-weight: 600; letter-spacing: .02em; padding: 4px 8px;\n    }\n\n    .tick { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #9b9ea7; font-weight: 500; }\n    .tick i { color: var(--green); font-size: 9px; }\n\n    @media (prefers-reduced-motion: reduce) {\n      .fade, .shiny, .plan-wrap.is-selected, .pay-card::after { animation: none; }\n      .shiny { color: #fff; -webkit-background-clip: initial; background-clip: initial; background: none; }\n    }\n\n    /* Ad-blocker bait: the class names every filter list hides on sight. If this element\n       ends up with no box, something is filtering the page. */\n    #ad-banner-bait { width: 300px; height: 90px; position: absolute; left: -9999px; top: -9999px; }\n  </style>\n</head>\n<body class=\"antialiased min-h-screen flex items-start md:items-center justify-center px-4 py-7 sm:py-10\">\n\n  <div class=\"ambient\"></div>\n\n  <!-- Anti-devtools curtain. Hidden by default; shown while developer tools appear open. -->\n  <div id=\"devtools-wall\" class=\"fixed inset-0 z-[400] hidden items-center justify-center p-6\" style=\"background:var(--bg);\">\n    <div class=\"w-full max-w-sm text-center rounded-2xl p-8\" style=\"background:var(--row);border:1px solid var(--line);\">\n      <img src=\"public/Kali Hub Logo.png\" alt=\"Kali Hub\" class=\"w-10 h-10 object-contain mx-auto mb-5\">\n      <h2 class=\"text-[17px] font-semibold tracking-tight\">Developer tools detected</h2>\n      <p class=\"text-[12.5px] mt-2\" style=\"color:var(--muted)\">Close developer tools to continue. The key system does not run while they are open.</p>\n    </div>\n  </div>\n\n  <!-- \u2500\u2500 Gate: browser check, then captcha \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <div id=\"gate\" class=\"fixed inset-0 z-[300] flex items-center justify-center p-4\" style=\"background:var(--bg);\">\n    <div class=\"w-full max-w-sm text-center rounded-2xl p-8\" style=\"background:var(--row);border:1px solid var(--line);\">\n      <img src=\"public/Kali Hub Logo.png\" alt=\"Kali Hub\" class=\"w-10 h-10 object-contain mx-auto mb-5\">\n      <h2 class=\"text-[17px] font-semibold tracking-tight\" id=\"gate-title\">Kali Hub</h2>\n      <p class=\"text-[12.5px] mt-2 mb-6\" style=\"color:var(--muted)\" id=\"gate-msg\">Checking your browser\u2026</p>\n\n      <div id=\"gate-turnstile\" class=\"hidden justify-center\"></div>\n      <div id=\"gate-spinner\" class=\"flex justify-center py-1\"><i class=\"fas fa-circle-notch fa-spin text-xl\" style=\"color:var(--muted)\"></i></div>\n\n      <button id=\"gate-retry\" onclick=\"boot()\" class=\"hidden w-full mt-5 py-3 rounded-xl font-semibold text-[13px]\" style=\"background:var(--green);color:#04240f;\">\n        Try again\n      </button>\n      <a id=\"gate-premium\" href=\"kalipremium\" class=\"hidden mt-3 text-[10.5px] font-semibold uppercase tracking-[0.15em]\" style=\"color:var(--muted)\">Get Kali Premium instead</a>\n    </div>\n  </div>\n\n  <!-- \u2500\u2500 Main \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <main id=\"app\" class=\"w-full max-w-[470px] hidden\">\n\n    <!-- Header -->\n    <div class=\"flex items-center gap-3 mb-5 sm:mb-6 fade fade-1\">\n      <img src=\"public/Kali Hub Logo.png\" alt=\"Kali Hub\" class=\"w-[26px] h-[26px] object-contain flex-shrink-0\">\n      <h1 class=\"text-[16px] sm:text-[18px] font-semibold tracking-[-0.02em] truncate min-w-0 flex-1\">Kali Hub \u2014 Key System</h1>\n      <a href=\"kalipremium\" class=\"premium-pill flex-shrink-0\">\n        <img src=\"public/Kali Hub Logo.png\" alt=\"\" class=\"w-[14px] h-[14px] object-contain\">\n        <span>Premium</span>\n        <span class=\"premium-off\">70% OFF</span>\n      </a>\n    </div>\n\n    <!-- The whole funnel. Hidden while a key from a previous run is still valid \u2014 that key\n         is the thing the funnel exists to produce, so there is nothing to do until it\n         expires (see showKey / getStoredKey). -->\n    <div id=\"funnel\">\n      <p class=\"text-[12.5px] font-medium mb-3.5 fade fade-2\" style=\"color:var(--steel)\">\n        To get your key, complete the following steps:\n      </p>\n\n      <!-- Steps -->\n      <div id=\"steps\" class=\"space-y-2 fade fade-2\"></div>\n\n      <!-- Waitlist + Proceed: hidden until every offer is verified -->\n      <div id=\"waitbar\" class=\"hidden mt-4 flex flex-col min-[420px]:flex-row items-stretch justify-center gap-2\">\n        <div id=\"waitpill\" class=\"waitpill flex-1\"><span id=\"wait-text\"></span></div>\n        <button id=\"proceed-btn\" class=\"btn-proceed min-[420px]:w-[168px]\" disabled onclick=\"onProceed()\">\n          <i class=\"fas fa-lock text-[10px]\"></i> <span id=\"proceed-label\">Unlock key</span>\n        </button>\n      </div>\n\n      <p id=\"flow-error\" class=\"hidden text-[11px] font-bold mt-3 text-center\" style=\"color:var(--red)\"></p>\n    </div>\n\n    <!-- Anchor the key card moves to once a key exists (see showKey) -->\n    <div id=\"key-slot\"></div>\n\n    <!-- OR -->\n    <div id=\"or-divider\" class=\"divider my-6 fade fade-3\">OR</div>\n\n    <!-- \u2500\u2500 Kali Premium \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n    <section class=\"fade fade-3\">\n      <div id=\"premium-pitch\" class=\"text-center mb-5\">\n        <p class=\"flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[13px] font-medium\">\n          <span>Or never come back here</span>\n          <img src=\"public/Kali Hub Logo.png\" alt=\"\" class=\"w-[18px] h-[18px] object-contain\">\n          <span class=\"shiny font-semibold\">Kali Premium</span>\n        </p>\n        <p class=\"mt-1.5 text-[11.5px]\" style=\"color:var(--muted)\">\n          Your own key, delivered at checkout \u2014 no key system at all.\n        </p>\n      </div>\n\n      <!-- Plans -->\n      <div id=\"plans\" class=\"space-y-2.5 pt-2\"></div>\n\n      <!-- Benefits -->\n      <div class=\"mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5\">\n        <span class=\"tick\"><i class=\"fas fa-check\"></i> No key system, ever</span>\n        <span class=\"tick\"><i class=\"fas fa-check\"></i> Key lasts the whole plan</span>\n        <span class=\"tick\"><i class=\"fas fa-check\"></i> Priority support and updates</span>\n        <span class=\"tick\"><i class=\"fas fa-check\"></i> Works on every supported game</span>\n        <span class=\"tick\"><i class=\"fas fa-check\"></i> No data shared</span>\n      </div>\n\n      <p class=\"mt-4 text-center text-[10.5px] font-medium leading-relaxed\" style=\"color:var(--muted)\">\n        <i class=\"far fa-envelope mr-1\"></i>\n        Your key is delivered instantly \u2014 to your purchase email.\n      </p>\n\n      <!-- Payment -->\n      <div class=\"mt-4 space-y-2 fade fade-4\">\n        <a id=\"pay-card\" href=\"#\" class=\"pay pay-card\">\n          <span>Pay with Card</span>\n          <!-- Brand marks drawn inline: the icon-font versions render as flat monochrome\n               glyphs, and a hosted image is exactly the kind of request an ad blocker eats. -->\n          <span class=\"flex items-center gap-1.5 ml-1\">\n  