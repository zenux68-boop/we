DNS, corporate filters) \u2014 across every browser.\n    // No single signal is trusted: independent vectors run and a block is declared only when\n    // at least TWO agree, so one flaky failure (a slow CDN, a hiccup) never blocks a real user.\n    //   1. DOM cosmetic bait \u2014 baits wearing EasyList ad classes, read AFTER a 200ms delay so\n    //      the blocker's cosmetic filter has run (reading immediately is why Brave slipped by).\n    //   2. Self-hosted /ads.js \u2014 first-party, returns 200 (no 404 FP), but its path is on every\n    //      network list, so a blocker refuses it while a clean browser loads it. First-party\n    //      means a proxy that blocks doubleclick alone cannot false-positive here.\n    //   3+4. TWO independent third-party canary groups. A DNS blocker resolves no ad host, so\n    //      it trips BOTH groups (two votes) and is caught even though it applies no cosmetic\n    //      filter and can't touch our first-party /ads.js. A single transient host failure\n    //      trips at most one group, so it never blocks on its own.\n    // Everything is fetch/DOM, never an executed ad <script>, so nothing pops before the\n    // captcha. Every network probe races a 4s timeout and fails OPEN, so an offline user is\n    // never wrongly blocked.\n    async function detectAdblock() {\n      const probe = function (url, opts) {\n        return Promise.race([\n          fetch(url, Object.assign({ cache: 'no-store' }, opts || {})).then(function () { return false; }, function () { return true; }),\n          new Promise(function (r) { setTimeout(function () { r(false); }, 4000); })   // offline: fail open\n        ]);\n      };\n      const anyBlocked = function (urls) {\n        return Promise.all(urls.map(function (u) { return probe(u, { mode: 'no-cors' }); }))\n          .then(function (r) { return r.indexOf(true) !== -1; });\n      };\n\n      // Vector 1: DOM cosmetic baits \u2014 the static one plus two runtime baits with different\n      // EasyList class combos, read after a 200ms delay so the cosmetic filter has run.\n      const domVote = (async function () {\n        try {\n          const baits = [document.getElementById('ad-banner-bait')];\n          [['ad-banner', 'adsbox', 'doubleclick', 'ad-placement'],\n           ['pub_300x250', 'sponsored', 'banner_ads', 'adsbygoogle']].forEach(function (classes) {\n            const el = document.createElement('div');\n            el.className = classes.join(' ');\n            el.style.cssText = 'position:absolute;left:-9999px;top:-9999px;width:300px;height:250px';\n            el.innerHTML = '&nbsp;';\n            document.body.appendChild(el);\n            baits.push(el);\n          });\n          await new Promise(function (r) { setTimeout(r, 200); });\n          return baits.some(function (el) {\n            if (!el) return false;\n            const cs = getComputedStyle(el);\n            return el.offsetParent === null || el.offsetHeight === 0 || cs.display === 'none' || cs.visibility === 'hidden';\n          });\n        } catch (_) { return true; }\n      })();\n\n      // Vector 2: self-hosted /ads.js (first-party, exists \u2192 no 404 FP; path is on every list).\n      const selfVote = probe('ads.js?_=' + Date.now());\n\n      // Vectors 3 & 4: two independent canary groups drawn from the ad hosts every list ships.\n      // Each group is one vote (any host in it blocked), so a DNS blocker that resolves no ad\n      // host trips both and is caught with no cosmetic or first-party signal at all.\n      const canaryA = anyBlocked([\n        'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js',\n        'https://googleads.g.doubleclick.net/pagead/id',\n        'https://www.googletagservices.com/tag/js/gpt.js'\n      ]);\n      const canaryB = anyBlocked([\n        'https://static.doubleclick.net/instream/ad_status.js',\n        'https://c.amazon-adsystem.com/aax2/apstag.js',\n        'https://cdn.adsafeprotected.com/iasPET.1.js'\n      ]);\n\n      // All vectors run concurrently, so the whole check is capped at the 4s probe timeout.\n      const results = await Promise.all([domVote, selfVote, canaryA, canaryB]);\n      const votes = results.filter(Boolean).length;\n      return votes >= 2;   // two independent signals must agree \u2014 near-zero false positives\n    }\n\n    // Chromium incognito detector (Chrome + Brave), desktop and mobile.\n    //\n    // Desktop Chrome exposes performance.memory, so the storage quota is compared to the JS\n    // heap limit \u2014 a private window's quota is far smaller. Mobile Chrome has NO\n    // performance.memory, so it falls back to an absolute quota threshold: a private window\n    // there is capped to a small quota while a normal window's tracks the disk (many GB).\n    // Any failure or a non-Chromium engine resolves false \u2014 it never blocks on uncertainty.\n    //\n    // ponytail: the mobile fallback is a heuristic \u2014 a phone with very little free space could\n    // report a low quota in a normal window too (false positive), and the newest Chrome has\n    // been narrowing the private-mode quota gap, so a future version may slip through. Tune\n    // INCOGNITO_MOBILE_QUOTA if either shows up. No client signal detects mobile incognito\n    // with zero false positives; the server-side block stays the enforcement point.\n    const INCOGNITO_MOBILE_QUOTA = 1200 * 1024 * 1024;   // ~1.2 GB\n    function detectIncognito() {\n      return new Promise(function (resolve) {\n        const quotaCb = function (quota) {\n          try {\n            if (performance && performance.memory && performance.memory.jsHeapSizeLimit) {\n              resolve(quota < performance.memory.jsHeapSizeLimit * 2);       // desktop\n            } else {\n              resolve(quota > 0 && quota < INCOGNITO_MOBILE_QUOTA);          // mobile fallback\n            }\n          } catch (_) { resolve(false); }\n        };\n        try {\n          const temp = navigator.webkitTemporaryStorage;\n          if (temp && temp.queryUsageAndQuota) {\n            temp.queryUsageAndQuota(function (_u, quota) { quotaCb(quota); }, function () { resolve(false); });\n            return;\n          }\n          if (navigator.storage && navigator.storage.estimate) {\n            navigator.storage.estimate().then(function (est) { quotaCb(est.quota || 0); }, function () { resolve(false); });\n            return;\n          }\n        } catch (_) {}\n        resolve(false);\n      });\n    }\n\n    // \u2500\u2500\u2500 Gate \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    function gateShow(title, msg, opts) {\n      // While a block is up it owns the gate: a stray \"Something went wrong\" from an in-flight\n      // request must not paint over the reason the user is actually stuck.\n      if (state.banned && title !== 'Access blocked') return;\n      opts = opts || {};\n      const g = document.getElementById('gate');\n      g.classList.remove('hidden'); g.classList.add('flex');\n      document.getElementById('gate-title').innerText = title;\n      document.getElementById('gate-msg').innerText = msg;\n      document.getElementById('gate-spinner').classList.toggle('hidden', !opts.spinner);\n      document.getElementById('gate-retry').classList.toggle('hidden', !opts.retry);\n      document.getElementById('gate-premium').classList.toggle('hidden', !opts.premium);\n      const cf = document.getElementById('gate-turnstile');\n      cf.classList.toggle('hidden', !opts.captcha);\n      cf.classList.toggle('flex', !!opts.captcha);\n    }\n\n    function gateHide() {\n      document.getElementById('gate').classList.add('hidden');\n      document.getElementById('app').classList.remove('hidden');\n    }\n\n    // \u2500\u2500\u2500 Turnstile \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    // Turnstile tokens are single-use and short-lived, so the widget is rendered only when\n    // the gate actually shows the captcha (into a VISIBLE container \u2014 rendering into a hidden\n    // one is why it sometimes never appeared) and a FRESH token is minted on every attempt\n    // via reset(). The one shared callback funnels its token to whichever request is waiting.\n    let cfWidgetId = null;\n    let cfToken = '';\n    let cfResolve = null;\n    function cfDeliver(t) { cfToken = t || ''; if (cfResolve) { const r = cfResolve; cfResolve = null; r(cfToken); } }\n\n    // Waits for api.js to define window.turnstile. Resolves false if it never arrives \u2014 iOS\n    // content blockers and Lockdown Mode drop the request, and the user must not be trapped.\n    function turnstileReady() {\n      return new Promise(function (resolve) {\n        if (window.turnstile && window.turnstile.render) return resolve(true);\n        let waited = 0;\n        const iv = setInterval(function () {\n          if (window.turnstile && window.turnstile.render) { clearInterval(iv); resolve(true); }\n          else if ((waited += 100) >= 8000) { clearInterval(iv); resolve(false); }\n        }, 100);\n      });\n    }\n\n    // Renders the widget the first time, resets it (new token) after that, and resolves with\n    // the token. No artificial timeout once it is on screen: a managed challenge may need a\n    // click, and the callback fires when the user \u2014 or the invisible check \u2014 completes it.\n    async function getCaptchaToken() {\n      if (!(await turnstileReady())) return '';        // script blocked: fail open, server decides\n      cfToken = '';\n      return await new Promise(function (resolve) {\n        cfResolve = resolve;\n        try {\n          if (cfWidgetId === null) {\n            cfWidgetId = turnstile.render('#gate-turnstile', {\n              sitekey: TURNSTILE_SITEKEY,\n              theme: 'dark',\n              callback: cfDeliver,\n              'error-callback':   function () { cfDeliver(''); },\n              'expired-callback': function () { cfToken = ''; },\n              'timeout-callback': function () { cfDeliver(''); }\n            });\n          } else {\n            turnstile.reset(cfWidgetId);\n          }\n        } catch (_) { cfDeliver(''); }\n      });\n    }\n\n    // \u2500\u2500\u2500 Seya return \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    // Seya redirects the offer tab back here after the visitor completes the locker\n    // (?bk=) and the session id Link Override wrote into the destination (?sid=). This tab\n    // holds no funnel state \u2014 it only reports the pair, and the server does the proving: the\n    // the return is accepted only after the server confirms the active Seya flow. The funnel tab\n    // is still polling and picks the step up on\n    // its own.\n    function clearReturnQuery() {\n      try { history.replaceState({}, document.title, location.pathname); } catch (_) {}\n    }\n\n    async function lockrReturn(returnToken) {\n      if (returnToken !== LOCKR_RETURN_TOKEN) {\n        clearReturnQuery();\n        gateShow('Could not verify', 'Invalid Seya return.', { retry: true, premium: true });\n        return;\n      }\n      if (!restoreFlowState()) {\n        clearReturnQuery();\n        gateShow('Could not verify', 'Return to the active Seya flow and complete the locker.', { retry: true, premium: true });\n        return;\n      }\n\n      gateShow('Verifying', 'Confirming your completion with Seya...', { spinner: true });\n      const d = await api('lockr_done', { flow_token: state.token, return_token: returnToken });\n      if (d && d.success) {\n        const next = await api('offer_done', { flow_token: state.token, i: 1 });\n        if (next) applyState(next);\n        gateShow('Step completed', 'You can close this tab - your key system tab has already continued.', {});\n        setTimeout(function () { try { window.close(); } catch (_) {} }, 1500);\n        clearReturnQuery();\n        return;\n      }\n      clearReturnQuery();\n      gateShow('Could not verify', (d && d.message) || 'Please complete the Seya locker again to continue.', { retry: true, premium: true });\n    }\n\n    // \u2500\u2500\u2500 Boot \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    async function boot() {\n      const q = new URLSearchParams(location.search);\n      if (q.get('lk_return') === LOCKR_RETURN_TOKEN) return lockrReturn(q.get('lk_return'));\n\n      gateShow('Kali Hub', 'Checking your browser\u2026', { spinner: true });\n      // boot() is also the \"Try again\" button. Restore a saved session first; expired or\n      // invalid sessions are cleared by the server through the normal restart path.\n      state.token = null; state.proof = ''; state.allDone = false;\n      state.waitStarted = false; state.busy = false;\n      state.offers = []; state.progress = []; state.planShown = false; state.skew = 0;\n      unlockSpin = null; beatsSinceSync = 0; lastSig = '';\n      renderPlans();\n\n      // A key from an earlier run is still valid: no captcha, no session, no offers call \u2014\n      // the funnel exists to produce this key and it already has one. Refresh, closed tab\n      // or new tab all land here.\n      const active = getStoredKey();\n      if (active) {\n        // The stored countdown is only a display. Luarmor decides whether the key still\n        // works \u2014 it can be deleted, banned or shortened in the panel at any time, and the\n        // funnel has to start over when that happens.\n        const live = await api('key_check', { user_key: active.key });\n        if (live && live.active === false) {\n          lsDel(KEY_STORAGE);                       // dead upstream: fall through to the funnel\n        } else {\n          if (live && live.expire_at) {             // Luarmor's expiry wins over ours\n            active.expireAt = live.expire_at * 1000;\n            saveKey(active.key, active.expireAt);\n          }\n          gateHide();\n          showKey(active.key, active.expireAt);\n          return;\n        }\n      }\n\n      if (restoreFlowState()) {\n        gateHide();\n        startDevtoolsWatch();\n        render();\n        tick();\n        return;\n      }\n\n      const signals = await collectSignals();\n      // Client-side short-circuit for instant feedback. The server re-checks all of these on\n      // init, so a tampered client that lies here is still blocked there.\n      const clientBlock = signalMessage(signals);\n      if (clientBlock) { gateShow(clientBlock[0], clientBlock[1], { retry: true, premium: true }); return; }\n\n      // Show the captcha in its visible container, then mint a fresh single-use token.\n      gateShow('Kali Hub', 'Complete the verification to start.', { captcha: true });\n      const token = await getCaptchaToken();\n      gateShow('Kali Hub', 'Loading your steps\u2026', { spinner: true });\n\n      // One init, one token. The server validates the Seya return internally, so there is no\n      // client retry loop here \u2014 retrying would resend this now-spent token and Turnstile\n      // would reject it as already used. A genuine failure sends the user to \"Try again\",\n      // which re-enters boot() and reset()s the widget for a brand new token.\n      const d = await api('init', { cf_token: token, signals: signals });\n\n      if (!d || !d.success) {\n        const title = (d && (d.blocked === 'vpn' || d.blocked === 'incognito' || d.blocked === 'userscript'))\n          ? 'Cannot continue' : 'Something went wrong';\n        gateShow(title, (d && d.message) || 'Could not reach the key server. Please try again.', { retry: true, premium: true });\n        return;\n      }\n\n      applyState(d);\n      gateHide();\n      startDevtoolsWatch();\n      tick();\n    }\n\n    // The message a set of signals earns, or null to let it through. Mirrors the server's\n    // kali_ks_signal_block precedence so client and server agree on what wins.\n    function signalMessage(s) {\n      if (s.webdriver || s.headless) return ['Automated browser detected', 'Please open this page in a normal browser to get your key.'];\n      if (s.userscript) return ['Userscript extension detected', 'Disable Tampermonkey / Greasemonkey for this site and reload \u2014 they are not allowed here.'];\n      if (s.incognito)  return ['Private window not supported', 'Open this page in a normal (non-Incognito) window and try again.'];\n      if (s.adblock) {\n        return ['Ad blocker detected', 'Disable your ad blocker for this site and try again \u2014 the ads are what keep this key system free.'];\n      }\n      return null;\n    }\n\n    // Seconds between \"has Seya reported this session yet?\" polls. Coming back to this tab\n    // asks immediately, so the wait is only ever this long while the user is somewhere else.\n    const POLL_EVERY = 3;\n    document.addEventListener('visibilitychange', function () {\n      if (!document.hidden) pollBeats = POLL_EVERY;\n    });\n\n    // \u2500\u2500\u2500 Steps \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    // A step is: idle -> (click: the Seya link opens in its own tab) -> waiting\n    // for Seya -> verified. Completion is real now: the step only flips once the tab Seya\n    // redirected back has had its API key validated server-side, so the spinner here is\n    // waiting on the other tab, not on a clock.\n    //\n    // Popunder (Adsterra). loadPopunder() fires exactly once in the whole flow \u2014\n    // the first time an offer is opened (openStep) \u2014 because that is the only moment the user\n    // is already leaving for another tab, so a pop underneath costs nothing and never touches\n    // the arrival screen, the waitlist, the key, or the Premium CTA. Nothing fires before the\n    // captcha; the ad-block probe fetches an ad host instead of executing it, so the gate\n    // stays clean.\n    //\n    // Each script installs a document-wide click handler that pops on the user's gestures, so\n    // it is injected ONCE and then left to the network's own frequency cap to throttle. Loading\n    // it repeatedly stacks handlers and pops on nearly every click \u2014 which is exactly what\n    // \"keeps firing\" looks like \u2014 so the guard below is what keeps it strategic, not spammy.\n\n    // \u2500\u2500\u2500 Anti-devtools \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    // Detection is the window-size delta: an open, docked DevTools panel shrinks the viewport\n    // well below the outer window. Zoom scales both together so it does not trip this, which\n    // keeps false positives near zero. While tools look open, a curtain covers the page and\n    // the waitlist freezes (pageIsActive() also gates the timer).\n    // ponytail: catches docked DevTools; an undocked (separate-window) panel does not change\n    // the size and slips past. The blocked shortcuts below raise the effort for everyone else.\n    // Nothing here is a security boundary \u2014 the server timing gates are.\n    let devtoolsOpen = false;\n    function devtoolsLikelyOpen() {\n      try {\n        const wThreshold = 170, hThreshold = 170;\n        const widthGap  = (window.outerWidth  - window.innerWidth);\n        const heightGap = (window.outerHeight - window.innerHeight);\n        // outerHeight always exceeds innerHeight by the browser chrome, so only a gap well\n        // past the normal toolbar height counts.\n        return widthGap > wThreshold || heightGap > hThreshold + 40;\n      } catch (_) { return false; }\n    }\n    function startDevtoolsWatch() {\n      const wall = document.getElementById('devtools-wall');\n      const paint = function () {\n        const open = devtoolsLikelyOpen();\n        if (open === devtoolsOpen) return;\n        devtoolsOpen = open;\n        wall.classList.toggle('hidden', !open);\n        wall.classList.toggle('flex', open);\n      };\n      paint();\n      setInterval(paint, 800);\n      window.addEventListener('resize', paint);\n    }\n\n    // Shortcut deterrence: F12, Ctrl/Cmd+Shift+I/J/C, Ctrl/Cmd+U. Cheap, defeatable, and\n    // deliberately not applied to inputs so copying the key with Ctrl+C still works.\n    document.addEventListener('keydown', function (e) {\n      const k = (e.key || '').toLowerCase();\n      const mod = e.ctrlKey || e.metaKey;\n      if (k === 'f12' ||\n          (mod && e.shiftKey && (k === 'i' || k === 'j' || k === 'c')) ||\n          (mod && k === 'u')) {\n        e.preventDefault();\n      }\n    });\n\n    // Arm Adsterra once per page load. After this, its own click handler and frequency cap\n    // decide when a pop actually shows \u2014 we do not re-inject and do not wipe its cap, so it\n    // stays throttled. A flow reset is a full page reload, which re-arms.\n    let adsArmed = false;\n    function loadPopunder() {\n      if (adsArmed) return;\n      adsArmed = true;\n      try {\n        const a = document.createElement('script');\n        a.src = ADSTERRA_SRC;\n        document.body.appendChild(a);\n      } catch (_) {}\n    }\n\n    function stepIcon(p) {\n      if (p && p.done) return '<i class=\"fas fa-check\"></i>';\n      if (p && p.opened) return '<i class=\"fas fa-circle-notch fa-spin\"></i>';\n      return '<i class=\"fas fa-chevron-right\"></i>';\n    }\n\n    // The step list is rebuilt only when something structural changes \u2014 a rebuild every\n    // second would restart every spinner animation. The countdowns update in place.\n    let lastSig = '';\n    function render() {\n      const sig = JSON.stringify([\n        state.offers.map(function (o) { return o.title; }),\n        state.progress.map(function (p) { return (p.opened ? 1 : 0) + '' + (p.done ? 1 : 0); }),\n        state.allDone, waitLeft() === 0, !!state.proof\n      ]);\n      if (sig !== lastSig) { lastSig = sig; renderSteps(); }\n      renderStatus();\n    }\n\n    function renderSteps() {\n      const rows = state.offers.map(function (o, idx) {\n        const n = idx + 1;\n        const p = state.progress[idx];\n        const done = !!(p && p.done);\n        const locked = n > 1 && !(state.progress[idx - 1] && state.progress[idx - 1].done);\n        const pending = !!(p && p.opened && !p.done);\n        return '<button type=\"button\" class=\"step' + (done ? ' is-done' : (locked ? ' is-locked' : (pending ? ' is-active' : ''))) + '\" data-step=\"' + n + '\"' + (done || locked ? ' disabled' : '') + '>' +\n                 '<span class=\"step-num\">' + n + '</span>' +\n                 '<span class=\"step-body\">' +\n                   '<span class=\"step-title\">' + esc(o.title) + '</span>' +\n                   '<span class=\"step-desc\">' + esc(o.desc) + '</span>' +\n                 '</span>' +\n                 '<span class=\"step-state\">' + stepIcon(p) + '</span>' +\n               '</button>';\n      }).join('');\n\n      // The final row exists only once every offer is verified \u2014 before that there is\n      // nothing to wait for and nothing to show.\n      const waitRow = !state.allDone ? '' :\n        '<div class=\"step is-active\">' +\n          '<span class=\"step-num\">' + (state.offers.length + 1) + '</span>' +\n          '<span class=\"step-body\">' +\n            '<span class=\"step-title\">Wait, or never do this again</span>' +\n            '<span class=\"step-desc\">Unlock is ready when the timer finishes</span>' +\n          '</span>' +\n          '<span class=\"step-state\">' +\n            (waitLeft() > 0 ? '<i class=\"fas fa-circle-notch fa-spin\"></i>' : '<i class=\"fas fa-check\" style=\"color:var(--green)\"></i>') +\n          '</span>' +\n        '</div>';\n\n      document.getElementById('steps').innerHTML = rows + waitRow;\n      document.getElementById('waitbar').classList.toggle('hidden', !state.allDone);\n    }\n\n    // Waitlist strip + Proceed, repainted every second.\n    function renderStatus() {\n      if (state.busy || state.keyDone || !state.allDone) return;\n      const btn   = document.getElementById('proceed-btn');\n      const label = document.getElementById('proceed-label');\n      const wt    = document.getElementById('wait-text');\n      const left  = waitLeft();\n\n      if (left > 0) {\n        document.getElementById('waitpill').classList.remove('hidden');\n        wt.innerHTML = 'You are on the waitlist: <span class=\"count\"><span class=\"emoji\">&#9203;</span> Unlocks in ' + fmt(left) + '</span>';\n        btn.disabled = true;\n        btn.classList.remove('ready');\n        btn.querySelector('i').className = 'fas fa-lock text-[10px]';\n        label.innerText = 'Unlock key';\n        return;\n      }\n\n      // Timer done. The strip says nothing \u2014 the button itself carries the news: a short\n      // spin, then it lights up.\n      document.getElementById('waitpill').classList.add('hidden');\n      if (unlockSpin === null) {\n        unlockSpin = setTimeout(function () { unlockSpin = 'done'; renderStatus(); }, 2400);\n      }\n      if (unlockSpin !== 'done' || !state.proof) {\n        btn.disabled = true;\n        btn.classList.remove('ready');\n        btn.querySelector('i').className = 'fas fa-circle-notch fa-spin text-[10px]';\n        label.innerText = '';\n        return;\n      }\n      btn.disabled = false;\n      btn.classList.add('ready');\n      btn.querySelector('i').className = 'fas fa-lock-open text-[10px]';\n      label.innerText = 'Unlock key';\n    }\n\n    // null = not started, a timeout id = spinning, 'done' = the button is live.\n    let unlockSpin = null;\n\n    function waitLeft() {\n      return state.waitStarted ? Math.max(0, state.waitLeft) : state.waitlistSec;\n    }\n\n    // The waitlist only runs while this page is the thing the user is looking at: another\n    // tab, another window, a minimised browser or a locked phone all stop it. visibility\n    // covers tab switches and mobile backgrounding; hasFocus covers alt-tabbing to another\n    // app with the page still on screen.\n    function pageIsActive() {\n      if (devtoolsOpen) return false;                    // the curtain is up; do not credit time\n      if (document.visibilityState !== 'visible') return false;\n      return typeof document.hasFocus === 'function' ? document.hasFocus() : true;\n    }\n\n    function fmt(sec) {\n      sec = Math.max(0, Math.floor(sec));\n      const m = Math.floor(sec / 60), s = sec % 60;\n      return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n    }\n\n    function esc(str) {\n      return String(str == null ? '' : str).replace(/[&<>\"']/g, function (c) {\n        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c];\n      });\n    }\n\n    function showError(msg) {\n      const el = document.getElementById('flow-error');\n      el.innerText = msg;\n      el.classList.remove('hidden');\n      setTimeout(function () { el.classList.add('hidden'); }, 6000);\n    }\n\n    document.getElementById('steps').addEventListener('click', function (e) {\n      const row = e.target.closest('[data-step]');\n      if (row) openStep(parseInt(row.getAttribute('data-step'), 10));\n    });\n\n    async function openStep(n) {\n      const o = state.offers[n - 1];\n      const p = state.progress[n - 1];\n      if (!o || (p && p.done) || state.busy) return;\n      if (n > 1 && !(state.progress[n - 2] && state.progress[n - 2].done)) {\n        showError('Complete the previous step first.');\n        return;\n      }\n\n      // The popup blocker only allows a window opened synchronously inside the click. Open a\n      // blank tab now, validate the session, then navigate it to the third-party URL. This\n      // prevents a stale restored link from stranding the user on Seya before the server can\n      // reject its expired session. The scheme is checked because the URL comes from a\n      // third-party API and ends up in window.open().\n      //\n      // `noopener` as a window feature makes open() return null even when it succeeded, and\n      // this needs the handle to tell \"blocked\" apart from \"opened\" \u2014 so the reference is\n      // severed by hand instead, which prevents reverse tabnabbing just the same.\n      const win = /^https?:\\/\\//i.test(o.url) ? window.open('about:blank', '_blank') : null;\n      if (win) { try { win.opener = null; } catch (_) {} }\n\n      // A blocked pop-up cannot complete the step, so say so instead of leaving the row spinning\n      // against a tab that never opened.\n      if (!win) {\n        showError('Your browser blocked the offer tab. Allow pop-ups for this site, then tap the step again.');\n        return;\n      }\n\n      const d = await api('offer_open', { flow_token: state.token, i: n });\n      if (!d || !d.success) {\n        try { win.close(); } catch (_) {}\n        if (d && d.restart) return restart(d.message);\n        showError((d && d.message) || 'Could not open the offer. Please try again.');\n        return;\n      }\n      applyState(d);\n      try { win.location.href = o.url; } catch (_) {\n        showError('Could not open the offer. Please try again.');\n      }\n    }\n\n    // One ticker drives the page. An open step is polled \u2014 the answer lives on the server,\n    // written by the tab Seya redirected back \u2014 and it keeps polling while this tab is in\n    // the background, because that is exactly where it is while the user is on the offer.\n    let pollingStep = 0;\n    let beatsSinceSync = 0;\n    let pollBeats = POLL_EVERY;\n    const BEAT_EVERY = 10;   // one heartbeat every ten seconds of screen time\n    async function tick() {\n      if (state.banned) return;\n      for (let i = 0; i < state.progress.length; i++) {\n        const p = state.progress[i];\n        if (!p || !p.opened || p.done) continue;\n        if (++pollBeats >= POLL_EVERY && pollingStep !== i + 1) {\n          pollBeats = 0;\n          pollingStep = i + 1;\n          const d = await api('offer_done', { flow_token: state.token, i: i + 1 });\n          pollingStep = 0;\n          if (d && d.restart) return restart(d.message);\n          if (d) applyState(d);\n        }\n      }\n\n      // The waitlist: it starts by itself once the last step verifies, and from then on it\n      // only moves while the page is active. The countdown on screen is a local copy that\n      // the heartbeat re-syncs to whatever the server has actually credited.\n      if (state.allDone && !state.keyDone && pageIsActive() && !state.busy) {\n        if (state.waitStarted && state.waitLeft > 0) state.waitLeft -= 1;\n\n        const needBeat = !state.waitStarted                       // first beat starts it\n          || ++beatsSinceSync >= BEAT_EVERY                       // routine re-sync\n          || (state.waitLeft <= 0 && !state.proof);               // finished: collect the proof\n\n        if (needBeat) {\n          beatsSinceSync = 0;\n          state.busy = true;\n          const d = await api('wait_tick', { flow_token: state.token });\n          state.busy = false;\n          if (d && d.restart) return restart(d.message);\n          if (d) applyState(d);\n        }\n      }\n\n      render();\n      setTimeout(tick, 1000);\n    }\n\n    function restart(msg) {\n      lsDel(FLOW_STORAGE);\n      state.token = null;\n      // The proof goes with the session it belonged to. Carrying it into the next run would\n      // mean sending a proof the server never issued for that session \u2014 which the server\n      // reads, correctly, as a script driving the funnel, and blocks for.\n      state.proof = '';\n      state.allDone = false;\n      state.waitStarted = false;\n      unlockSpin = null;\n      gateShow('Session expired', msg || 'Please start again.', { retry: true, premium: true });\n    }\n\n    // \u2500\u2500\u2500 Plans \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    function planMarkup(p, i) {\n      const price = p.price\n        ? '<span class=\"text-right flex-shrink-0\" data-price=\"' + i + '\"><span class=\"plan-price\">' + p.price + '</span><span class=\"plan-unit\">' + esc(p.unit || '') + '</span></span>'\n        : '<i class=\"fas fa-arrow-right text-[11px]\" style=\"color:var(--muted)\"></i>';\n      const isSel = i === selectedPlan;\n      return '<div class=\"plan-wrap' + (isSel ? ' is-selected' : '') + '\">' +\n               (p.badge ? '<span class=\"badge-most\">' + esc(p.badge) + '</span>' : '') +\n               '<button type=\"button\" class=\"plan' + (isSel ? ' selected' : '') + '\" data-plan=\"' + i + '\">' +\n               '<span class=\"min-w-0 flex-1\">' +\n                 '<span class=\"flex items-center gap-2\">' +\n                   '<span class=\"text-[13.5px] font-black\">' + esc(p.name) + '</span>' +\n                   (p.tag ? '<span class=\"text-[8px] font-black uppercase tracking-[0.12em] px-1.5 py-0.5 rounded\" style=\"background:var(--green);color:#05230f\">' + esc(p.tag) + '</span>' : '') +\n                 '</span>' +\n                 '<span class=\"block text-[10.5px] font-medium mt-0.5\"' + (p.unit === '/weekly' ? ' data-weekly-sub' : p.unit === '/monthly' ? ' data-monthly-sub' : '') + ' style=\"color:var(--muted)\">' + esc(p.sub) + '</span>' +\n               '</span>' +\n               price +\n               '</button>' +\n             '</div>';\n    }\n\n    // \u2500\u2500 Localized price display (approximate) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    // The card shows an APPROXIMATE price in the visitor's currency; the exact charge is set\n    // by Stripe Adaptive Pricing at checkout, so a small difference is expected (the \"\u2248\"\n    // signals that). Country comes from Cloudflare's same-origin trace \u2014 no key, not blockable,\n    // no mixed-content problem the way a client-side ip-api call would have. The FX rate is a\n    // free no-key lookup cached for a day. Any failure silently leaves the base price shown.\n    // ponytail: set BASE_CURRENCY to 'BRL' (and the plan `amount`s to your BRL prices) the\n    // moment the SellAuth product is priced in BRL, so the card matches the localized checkout.\n    const BASE_CURRENCY = 'BRL';\n    const COUNTRY_CCY = {\n      US:'USD', BR:'BRL', GB:'GBP', CA:'CAD', AU:'AUD', NZ:'NZD', JP:'JPY', CN:'CNY', IN:'INR',\n      ID:'IDR', PH:'PHP', TH:'THB', VN:'VND', MY:'MYR', SG:'SGD', KR:'KRW', HK:'HKD', TW:'TWD',\n      TR:'TRY', RU:'RUB', UA:'UAH', ZA:'ZAR', NG:'NGN', EG:'EGP', KE:'KES', MA:'MAD', SA:'SAR',\n      AE:'AED', IL:'ILS', QA:'QAR', KW:'KWD', MX:'MXN', AR:'ARS', CL:'CLP', CO:'COP', PE:'PEN',\n      UY:'UYU', CH:'CHF', NO:'NOK', SE:'SEK', DK:'DKK', PL:'PLN', CZ:'CZK', HU:'HUF', RO:'RON',\n      BG:'BGN', IS:'ISK',\n      AT:'EUR', BE:'EUR', CY:'EUR', EE:'EUR', FI:'EUR', FR:'EUR', DE:'EUR', GR:'EUR', IE:'EUR',\n      IT:'EUR', LV:'EUR', LT:'EUR', LU:'EUR', MT:'EUR', NL:'EUR', PT:'EUR', SK:'EUR', SI:'EUR',\n      ES:'EUR', HR:'EUR'\n    };\n\n    let priceFmt = null, priceRate = 1;   // set once localization is ready\n    function applyLocalizedPrices() {\n      if (!priceFmt) return;\n      document.querySelectorAll('[data-price]').forEach(function (cell) {\n        const i = parseInt(cell.getAttribute('data-price'), 10);\n        const p = PLANS[i];\n        if (!p || typeof p.amount !== 'number') return;\n        cell.innerHTML = '<span class=\"plan-price plan-price-loc\">\u2248 ' + esc(priceFmt.format(p.amount * priceRate)) + '</span>' +\n                         '<span class=\"plan-unit\">' + esc(p.unit || '') + '</span>';\n      });\n      const weeklySub = document.querySelector('[data-weekly-sub]');\n      if (weeklySub && PLANS[0] && typeof PLANS[0].amount === 'number') {\n        weeklySub.textContent = '7 days \u00b7 about ' + priceFmt.format(PLANS[0].amount * priceRate / 7) + ' daily';\n      }\n      const monthlySub = document.querySelector('[data-monthly-sub]');\n      if (monthlySub && PLANS[1] && typeof PLANS[1].amount === 'number') {\n        monthlySub.textContent = '30 days \u00b7 about ' + priceFmt.format(PLANS[1].amount * priceRate / (30.4375 / 7)) + ' a week';\n      }\n    }\n\n    (async function setupLocalizedPrices() {\n      let cc = '';\n      try {\n        const t = await fetch('/cdn-cgi/trace', { cache: 'no-store' }).then(function (r) { return r.text(); });\n        cc = (t.match(/loc=([A-Z]{2})/) || [])[1] || '';\n      } catch (_) {}\n      const ccy = COUNTRY_CCY[cc] || '';\n      if (!ccy || ccy === BASE_CURRENCY) return;\n\n      let rates = null;\n      try {\n        const key = 'kali_fx_' + BASE_CURRENCY;\n        let cached = null;\n        try { cached = JSON.parse(localStorage.getItem(key) || 'null'); } catch (_) {}\n        if (cached && (Date.now() - cached.t) < 86400000 && cached.r) rates = cached.r;\n        if (!rates) {\n          const j = await fetch('https://open.er-api.com/v6/latest/' + BASE_CURRENCY, { cache: 'no-store' }).then(function (r) { return r.json(); });\n          if (j && j.result === 'success' && j.rates) {\n            rates = j.rates;\n            try { localStorage.setItem(key, JSON.stringify({ t: Date.now(), r: rates })); } catch (_) {}\n          }\n        }\n      } catch (_) {}\n      if (!rates || !rates[ccy]) return;\n\n      try { priceFmt = new Intl.NumberFormat(undefined, { style: 'currency', currency: ccy }); }\n      catch (_) { return; }\n      priceRate = rates[ccy];\n      applyLocalizedPrices();\n    })();\n\n    function renderPlans() {\n      document.getElementById('plans').innerHTML = PLANS.map(planMarkup).join('');\n      syncPayButtons();\n      applyLocalizedPrices();\n    }\n\n    // Every payment button checks out the plan that is currently selected.\n    function syncPayButtons() {\n      const url = PLANS[selectedPlan].url;\n      ['pay-card', 'pay-apple', 'pay-link', 'pay-google'].forEach(function (id) {\n        const el = document.getElementById(id);\n        if (el) el.href = url;\n      });\n    }\n\n    // A plan card picks what the payment buttons below it will check out.\n    document.addEventListener('click', function (e) {\n      const card = e.target.closest('[data-plan]');\n      if (!card) return;\n      const i = parseInt(card.getAttribute('data-plan'), 10);\n      if (isNaN(i)) return;\n      selectedPlan = i;\n      renderPlans();\n    });\n\n    // SpotlightCard: feed the pointer position to CSS instead of animating in JS, so the\n    // paint stays on the compositor.\n    document.addEventListener('pointermove', function (e) {\n      const card = e.target.closest('.plan');\n      if (!card) return;\n      const r = card.getBoundingClientRect();\n      card.style.setProperty('--mx', (e.clientX - r.left) + 'px');\n      card.style.setProperty('--my', (e.clientY - r.top) + 'px');\n    });\n\n    // \u2500\u2500\u2500 Proceed \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    // The first click sends them to the Premium page in a new tab; coming back and pressing\n    // Proceed again continues to the key.\n    async function onProceed() {\n      if (!state.proof || state.busy) return;\n\n      // Once, before the key: the Premium pitch opens in its own tab. Coming back and\n      // pressing Proceed again continues the funnel.\n      if (!state.planShown) {\n        state.planShown = true;\n        saveFlowState();\n        location.href = 'kalipremium?from=keysystem';\n        return;\n      }\n\n      const btn = document.getElementById('proceed-btn');\n      const label = document.getElementById('proceed-label');\n      state.busy = true;\n      btn.disabled = true;\n      btn.querySelector('i').className = 'fas fa-circle-notch fa-spin text-[10px]';\n      label.innerText = 'Generating\u2026';\n\n      // A second, fresh Turnstile \u2014 the one at init was solved five minutes ago and a key farm\n      // amortises that across a pool of parked sessions. This one is spent at the instant a key\n      // is actually minted, so it cannot be prepared in advance. Usually invisible; the gate is\n      // only on screen long enough for the widget to answer.\n      gateShow('Almost there', 'One last verification before your key\u2026', { captcha: true });\n      const cfTok = await getCaptchaToken();\n      gateHide();\n\n      const d = await api('verify', { flow_token: state.token, verify_proof: state.proof, cf_token: cfTok });\n\n      state.busy = false;\n      if (!d || !d.success) {\n        btn.disabled = false;\n        btn.querySelector('i').className = 'fas fa-lock-open text-[10px]';\n        label.innerText = 'Unlock key';\n        if (d && d.restart) return restart(d.message);\n        showError((d && d.message) || 'Could not generate your key. Please try again.');\n        return;\n      }\n\n      // The server's expiry is authoritative \u2014 the key stays valid exactly as long as\n      // Luarmor says, not as long as this tab thinks.\n      const expireAt = d.expire_at * 1000;\n      saveKey(d.user_key, expireAt);\n      showKey(d.user_key, expireAt);\n      lsDel(FLOW_STORAGE);\n      loadPopunder();\n    }\n\n    // \u2500\u2500\u2500 Key \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    // The key outlives the page: it is stored with the server's own expiry, survives a\n    // refresh, a closed tab and a new tab, and when it finally expires the whole funnel\n    // comes back from step 1.\n\n    // Returns the stored key only while it is genuinely usable. Anything else \u2014 malformed,\n    // expired, unreadable \u2014 is deleted along with the funnel session, so the next boot\n    // starts a clean run instead of resuming a session whose key is already gone.\n    function getStoredKey() {\n      try {\n        const raw = lsGet(KEY_STORAGE);\n        if (!raw) return null;\n        const o = JSON.parse(raw);\n        if (!o || typeof o.key !== 'string' || typeof o.expireAt !== 'number' ||\n            isNaN(o.expireAt) || o.expireAt < 1577836800000) {    // 2020-01-01: junk\n          lsDel(KEY_STORAGE);\n          return null;\n        }\n        if (Date.now() >= o.expireAt) {\n          lsDel(KEY_STORAGE);                                      // expired while away\n          return null;\n        }\n        return o;\n      } catch (_) {\n        lsDel(KEY_STORAGE);\n        return null;\n      }\n    }\n\n    function saveKey(key, expireAtMs) {\n      // lsSet never throws: the key must reach the screen even when storage is unavailable,\n      // because the server has already burned the session and cannot reissue it.\n      lsSet(KEY_STORAGE, JSON.stringify({ key: key, expireAt: expireAtMs }));\n    }\n\n    let keyTimer = null;\n    let keyWatch = null;\n    let keyWatchBound = false;\n\n    // Keep asking Luarmor whether this key is still alive: every five minutes, and the\n    // moment the tab comes back to the front. A verdict of \"not active\" restarts the funnel\n    // immediately instead of waiting for the local countdown to run out. Anything the server\n    // could not determine (Luarmor down, rate limited) leaves the key alone \u2014 active comes\n    // back as null there, and only an explicit false takes a key away.\n    function watchKeyLife(key) {\n      clearInterval(keyWatch);\n\n      const check = async function () {\n        if (document.hidden) return;\n        const live = await api('key_check', { user_key: key });\n        if (!live) return;\n        if (live.active === false) return expireNow();\n        if (live.expire_at) {\n          const ms = live.expire_at * 1000;\n          saveKey(key, ms);\n          if (keyExpireAt !== ms) { keyExpireAt = ms; }\n        }\n      };\n\n      keyWatch = setInterval(check, 300000);\n      if (!keyWatchBound) {\n        keyWatchBound = true;\n        document.addEventListener('visibilitychange', function () { if (!document.hidden) check(); });\n      }\n    }\n\n    let keyExpireAt = 0;\n    function showKey(key, expireAtMs) {\n      state.keyDone = true;\n      // No popunder here: the key screen is where the user reads their key and where the\n      // Premium CTA sits, so an interruption would only cost us the upsell.\n\n      // The funnel has nothing left to do while this key lives.\n      document.getElementById('funnel').classList.add('hidden');\n\n\n      const card = document.getElementById('key-card');\n      card.classList.remove('hidden');\n      // With the funnel gone the key is the whole point of the page, so it moves up to the\n      // top instead of sitting below the Premium block.\n      const slot = document.getElementById('key-slot');\n      if (slot && slot.parentNode) slot.parentNode.insertBefore(card, slot);\n\n      // Nothing is being chosen between any more, so the OR rule goes with the funnel.\n      const rule = document.getElementById('or-divider');\n      if (rule) rule.classList.add('hidden');\n\n      // The pitch changes once they hold a key: there is nothing left to skip today, but\n      // this key expires and the steps come back tomorrow.\n      const pitch = document.getElementById('premium-pitch');\n      if (pitch) {\n        pitch.classList.add('mt-5');   // the OR rule that used to sit above it is gone\n        pitch.innerHTML =\n          '<p class=\"flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[13px] font-medium\">' +\n            '<span>This key expires in 24 hours and the steps start over. A premium key does not.</span>' +\n          '</p>' +\n          '<p class=\"mt-1.5 flex flex-wrap items-center justify-center gap-x-2 text-[11.5px]\" style=\"color:var(--muted)\">' +\n            '<img src=\"public/Kali Hub Logo.png\" alt=\"\" class=\"w-[16px] h-[16px] object-contain\">' +\n            '<span class=\"shiny font-semibold\">Kali Premium</span>' +\n            '<span>\u2014 your own key, for the whole plan.</span>' +\n          '</p>';\n      }\n      document.getElementById('key-display').innerText = key;\n\n      keyExpireAt = expireAtMs;\n      watchKeyLife(key);\n\n      clearInterval(keyTimer);\n      const paint = function () {\n        const left = keyExpireAt - Date.now();\n        if (left <= 0) {\n          clearInterval(keyTimer);\n          expireNow();\n          return;\n        }\n        const h = Math.floor(left / 3600000);\n        const m = Math.floor(left / 60000) % 60;\n        const s = Math.floor(left / 1000) % 60;\n        document.getElementById('key-left').innerText = h + 'h ' + m + 'm ' + s + 's';\n      };\n      paint();\n      keyTimer = setInterval(paint, 1000);\n    }\n\n    // Key expired with the page open: drop it, drop the session, and put the user back at\n    // step 1. A reload is the honest reset \u2014 it re-runs the captcha and mints a fresh\n    // session exactly like a first visit, with no half-restored state left behind.\n    function expireNow() {\n      lsDel(KEY_STORAGE);\n      window.location.reload();\n    }\n\n    function copyKey() {\n      const key = document.getElementById('key-display').innerText;\n      if (!key || key === '\u2014') return;\n      navigator.clipboard.writeText(key).catch(function () {\n        const t = document.createElement('textarea');\n        t.value = key; document.body.appendChild(t); t.select();\n        try { document.execCommand('copy'); } catch (_) {}\n        t.remove();\n      });\n      const st = document.getElementById('key-status');\n      st.innerText = 'Copied';\n      setTimeout(function () { st.innerText = 'Active'; }, 1500);\n    }\n\n    boot();\n  </script>\n</body>\n</html>\n"}
