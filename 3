here can be dismissed: the curtain stays up, the\n    // ticker stops, and the countdown runs until the block lifts.\n    let banTimer = null;\n    function showBan(d) {\n      state.banned = true;\n      state.busy = true;\n      clearInterval(banTimer);\n      clearInterval(keyTimer);\n      clearInterval(keyWatch);\n\n      const until = (d && typeof d.until === 'number') ? d.until * 1000 : 0;\n      const base  = (d && d.message) || 'Access temporarily blocked.';\n\n      const paint = function () {\n        const left = until ? until - Date.now() : 0;\n        if (until && left <= 0) {\n          clearInterval(banTimer);\n          state.banned = false;                     // let the retry actually re-enter boot()\n          gateShow('Block expired', 'You can start the key system again.', { retry: true });\n          return;\n        }\n        gateShow('Access blocked', until ? base + ' Lifts in ' + fmtLong(left / 1000) + '.' : base,\n                 { premium: true });\n      };\n      paint();\n      banTimer = setInterval(paint, 1000);\n    }\n\n    function fmtLong(sec) {\n      sec = Math.max(0, Math.floor(sec));\n      const h = Math.floor(sec / 3600), m = Math.floor(sec / 60) % 60, s = sec % 60;\n      return (h > 0 ? h + 'h ' : '') + (h > 0 || m > 0 ? m + 'm ' : '') + s + 's';\n    }\n\n    // Every response that carries state carries the whole state, so there is one place\n    // that applies it.\n    function applyState(d) {\n      if (!d) return;\n      if (d.flow_token) state.token = d.flow_token;\n      if (typeof d.now === 'number') state.skew = d.now * 1000 - Date.now();\n      if (Array.isArray(d.offers) && d.offers.length) state.offers = d.offers;\n      if (Array.isArray(d.progress)) state.progress = d.progress;\n      if (typeof d.waitlist_sec === 'number') state.waitlistSec = d.waitlist_sec;\n      state.allDone = !!d.all_done;\n      if (d.wait_started && typeof d.wait_left === 'number') {\n        state.waitStarted = true;\n        state