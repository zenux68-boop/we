x] font-bold uppercase tracking-[0.16em] transition-colors\" style=\"color:#4a4a53\" onmouseover=\"this.style.color='#fff'\" onmouseout=\"this.style.color='#4a4a53'\">\n        <i class=\"fas fa-arrow-left mr-1.5\"></i> Back to Get Key\n      </a>\n    </div>\n  </main>\n\n  <div id=\"ad-banner-bait\" class=\"ad-banner adsbox ad-placement pub_300x250 sponsored doubleclick text-ad\">&nbsp;</div>\n\n  <script>\n    // \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n    // Kali Hub key system \u2014 client.\n    //\n    // The client owns nothing that matters: every timer here is cosmetic and is\n    // re-checked server-side against the server clock before a key is minted. It\n    // holds one HMAC-signed token it cannot forge, and asks the server to advance\n    // the state machine one step at a time.\n    // \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n\n    const ENDPOINT    = 'keysystem.php';\n    // The signed funnel token and its display state survive navigation back from Premium.\n    // The server still validates the token on every state-changing request.\n    const KEY_STORAGE  = 'kali_active_key';  // shared with the other key pages\n    const FLOW_STORAGE = 'kali_flow_state';\n    const LOCKR_RETURN_TOKEN = 'b015cc1fbf8f65580e77f7e16357b53bf46f';\n    const ADSTERRA_SRC = 'https://strengthdetention.com/e6/a8/4a/e6a84a06ddc67bc2cf44093bf636f8ce.js';\n    const TURNSTILE_SITEKEY = '0x4AAAAAAD6j_nCeEONsamGX';\n\n    // \u2500\u2500\u2500 Plans \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    // SellAuth checkout links need an explicit variantId, so each plan carries its own.\n    // `price`/`unit` are display only \u2014 they must be kept in step with the store by hand,\n    // since the storefront cannot be read from here.\n    const PLANS = [\n      {\n        id: 'weekly',\n        name: 'Weekly',\n        sub: '7 days \u00b7 about R$2.29 daily',\n        badge: 'MOST BOUGHT',\n        price: 'R$16',\n        amount: 16,        // base amount in BASE_CURRENCY (see localizePrices)\n        unit: '/weekly',\n        url: 'https://kalihub.mysellauth.com/checkout-link?cart[0][productId]=521548&cart[0][variantId]=791739&cart[0][quantity]=1'\n      },\n      {\n        id: 'monthly',\n        name: 'Monthly',\n        sub: '30 days \u00b7 about R$7 a week',\n        badge: '',\n        tag: 'BEST VALUE',\n        price: 'R$32',\n        amount: 32,\n        unit: '/monthly',\n        url: 'https://kalihub.mysellauth.com/checkout-link?cart[0][productId]=521548&cart[0][variantId]=791751&cart[0][quantity]=1'\n      }\n    ];\n    let selectedPlan = 0;\n\n    // Safari with \"Block All Cookies\" throws on ANY localStorage access, even a bare read,\n    // so nothing here touches it directly \u2014 the funnel still works in memory for the page.\n    const mem = {};\n    function lsGet(k) { try { const v = localStorage.getItem(k); if (v !== null) return v; } catch (_) {} return k in mem ? mem[k] : null; }\n    function lsSet(k, v) { mem[k] = v; try { localStorage.setItem(k, v); } catch (_) {} }\n    function lsDel(k) { delete mem[k]; try { localStorage.removeItem(k); } catch (_) {} }\n\n    function saveFlowState() {\n      if (!state.token || !state.offers.length) return;\n      lsSet(FLOW_STORAGE, JSON.stringify({\n        token: state.token,\n        offers: state.offers,\n        progress: state.progress,\n        waitlistSec: state.waitlistSec,\n        waitLeft: state.waitLeft,\n        waitStarted: state.waitStarted,\n        allDone: state.allDone,\n        proof: state.proof,\n        skew: state.skew,\n        planShown: state.planShown\n      }));\n    }\n\n    function restoreFlowState() {\n      try {\n        const raw = lsGet(FLOW_STORAGE);\n        if (!raw) return false;\n        const saved = JSON.parse(raw);\n        if (!saved || typeof saved.token !== 'string' || !saved.token ||\n            !Array.isArray(saved.offers) || !saved.offers.length ||\n            saved.offers.length !== 1 || !Array.isArray(saved.progress) || saved.progress.length !== saved.offers.length) {\n          lsDel(FLOW_STORAGE);\n          return false;\n        }\n        state.token = saved.token;\n        state.offers = saved.offers;\n        state.progress = saved.progress;\n        state.waitlistSec = typeof saved.waitlistSec === 'number' ? saved.waitlistSec : 120;\n        state.waitLeft = typeof saved.waitLeft === 'number' ? saved.waitLeft : state.waitlistSec;\n        state.waitStarted = !!saved.waitStarted;\n        state.allDone = !!saved.allDone;\n        state.proof = typeof saved.proof === 'string' ? saved.proof : '';\n        state.skew = typeof saved.skew === 'number' ? saved.skew : 0;\n        state.planShown = !!saved.planShown;\n        return true;\n      } catch (_) {\n        lsDel(FLOW_STORAGE);\n        return false;\n      }\n    }\n\n    let state = {\n  